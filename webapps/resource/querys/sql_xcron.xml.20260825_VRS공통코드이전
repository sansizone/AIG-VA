	<sql-service name='wfm.xcron.xcron010m.servicelog.sel' datasource='is_stat' type='prepared'>
		<description>XCron 서비스 로그 조회</description>
		<result-name>ds_servicelog</result-name>
		<query><![CDATA[
			SELECT
                SERVICE_IP,
                SERVICE_NAME,
                START_DATETIME,
                END_DATETIME,
                EXECUTE_TIME,
                START_DATE,
                SUBSTRING(START_TIME, 1, 4) START_TIME,
                PROC_RSLT,
                ERR_MSG,
                PROC_FILECNT,
                '' AS DESCRIPTION
            FROM ms_xcron_service_log
            WHERE ?p_service_name
            AND START_DATE BETWEEN ?p_sdate AND ?p_edate
            AND START_TIME BETWEEN concat(?p_stime,'00') AND concat(?p_etime,'00')
            AND ?p_proc_rslt
            AND ?p_server_ip
            ORDER BY START_TIME desc
        ]]></query>
		<parameter name='p_service_name' value="SERVICE_NAME like '%' || ?p_service_name || '%'" default="1=1" />
		<parameter name='p_server_ip' value="SERVICE_IP = ?p_server_ip" default="1=1" />
		<parameter name='p_proc_rslt' value="PROC_RSLT = ?p_proc_rslt" default="1=1" />
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.getrealtimeinfo_1' datasource='aig_rec' type='prepared'>
		<description>녹취정보 수집</description>
		<result-name>msens.xcron.hansol.getrealtimeinfo_1</result-name>
		<query><![CDATA[
			SELECT DISTINCT 
				   FILEID,
				   concat(SpCode,'_',RecStartDT,'_',AgentID) AS UCID,
				   SpCode AS SP_CODE,
				   RecStartDT AS REC_START_DT,
				   AgentID AS AGENT_ID,
				   STT_FLAG,
				   STT_ERR_CD,
				   STT_R_TIME,
				   AgentID,
				   Duration as DURATION,
				   TPANO,
				   OrgFileFullPath AS ORG_FILE_FULL_PATH,
				   BATCH_YN
			FROM Sponsor_Callinfo WITH(NOLOCK) outer apply  dbo.fn_split_string(TPANO, ';') A, 
				(SELECT TOP(60) A.Items
				 FROM (SELECT Items,
							   CASE WHEN SUM(CASE WHEN STT_FLAG NOT IN ('N', 'S', 'E')  THEN 1 ELSE 0 END) = COUNT(ITEMS) THEN 'Y' ELSE 'N' END AS STT_YN,
							   MAX(InsDate) AS InsDate
						FROM  Sponsor_Callinfo WITH(NOLOCK) outer apply dbo.fn_split_string(TPANO, ';') 
						WHERE RecStartDT BETWEEN CONVERT(VARCHAR,FORMAT(GETDATE()-105, 'yyyyMMdd'))+'000000' AND CONVERT(VARCHAR,FORMAT(GETDATE(), 'yyyyMMdd'))+'235959'
						AND TPANO <> ''
						AND RecStartDT IS NOT NULL
						AND SpCode <> '30384'
						AND BATCH_YN IN ('N', 'Y')
						AND (VA_FLAG IS NULL OR VA_FLAG = 'N')
						AND (Items <> '' AND Items <> 'CS' AND Items <> 'Plan_no')
						GROUP BY Items
					 ) A
				WHERE A.STT_YN = 'Y' -- 설계번호의 모든 STT 분석이 다 됐거나 오류가 있는 콜만 분석한다
				ORDER BY InsDate DESC
				) RE
			WHERE A.ITEMS = RE.ITEMS
			AND TPANO <> ''
			AND RecStartDT BETWEEN CONVERT(VARCHAR,FORMAT(GETDATE()-105, 'yyyyMMdd'))+'000000' AND CONVERT(VARCHAR,FORMAT(GETDATE(), 'yyyyMMdd'))+'235959'
			AND RecStartDT IS NOT NULL
			AND SpCode <> '30384'
			AND STT_FLAG NOT IN ('N', 'S', 'E')
			AND BATCH_YN IN ('N', 'Y')
			AND (VA_FLAG IS NULL OR VA_FLAG = 'N')
			ORDER BY TPANO DESC
        ]]></query>
	 </sql-service>
	  
