	<sql-service name='msens.xcron.hansol.setscriptresultwebaction_3' datasource='is_stat' type='prepared'>
		<description>스크립트 점수 배정하기</description>
		<result-name>msens.xcron.hansol.setscriptresultwebaction_3</result-name>
		<query><![CDATA[
			SELECT re.CON_ENT_DGN_NO
			       ,re.S_CTRA_INSA_CLCD
				   ,re.CTRA_INSA_CLCD
				   ,re.USER_ID
				   ,re.ISTP_CD
				   ,re.ISTP_NM
				   ,re.PROD_CD
				   ,re.PROD_NM
				   ,re.TREATYHQCD
				   ,re.TREATYHQNM
				   ,re.TREATYBRHCD
				   ,re.TREATYBRHNM
				   ,re.TREATYDEPTCD
				   ,re.TREATYDEPTNM
				   ,ISNULL(SENT_SCORE,0) REGU_SCORE
				   ,re.SC_LCLF_CD
				   ,re.SC_SCLF_CD
				   ,re.SC_SNO
				   ,re.QST_CD
				   ,re.CENTERCD AS CNTR_CD
				   ,re.SCRIPT_SENT_ID
				   ,(SELECT QST_FOCUS FROM ms_script_mng WHERE SC_SNO = re.SC_SNO AND SC_LCLF_CD = re.SC_LCLF_CD AND SC_SCLF_CD =re.SC_SCLF_CD AND QST_CD = re.QST_CD AND CNTR_CD = re.CNTR_CD) AS QST_FOCUS
				   ,(SELECT QST_SECRET FROM ms_script_mng WHERE SC_SNO = re.SC_SNO AND SC_LCLF_CD = re.SC_LCLF_CD AND SC_SCLF_CD = re.SC_SCLF_CD AND QST_CD = re.QST_CD AND CNTR_CD = re.CNTR_CD) AS QST_SECRET
				   -- ,COUNT(1) AS TOT_CNT
				   -- ,SUM(CASE WHEN ISNULL(SENT_SCORE,0) = 0 THEN 0 ELSE 1 END) AS REGU_CNT
				   -- ,ROUND(CONVERT( FLOAT, (SUM(CASE WHEN ISNULL(SENT_SCORE,0) = 0 THEN 0 ELSE 1 END)/ CONVERT(FLOAT, COUNT(1))) * 100),2,1) AS REGU_SCORE
			FROM ( SELECT DISTINCT CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD, CTRA_INSA_CLCD, SCRIPT_SENT_ID, MAX(SENT_SCORE) AS SENT_SCORE
					FROM ms_regu_score WITH(NOLOCK)
					WHERE SENT_SCORE IN ( SELECT MAX(SENT_SCORE)
										FROM ms_regu_score
										WHERE CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
										GROUP BY CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD, CTRA_INSA_CLCD, SCRIPT_SENT_ID) 
					AND CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
					GROUP BY CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD, CTRA_INSA_CLCD, SCRIPT_SENT_ID
				  ) S RIGHT OUTER JOIN
			(SELECT X.CON_ENT_DGN_NO
			      ,A.SC_SNO
				  ,A.SC_LCLF_CD
				  ,A.SC_SCLF_CD
				  ,A.SCRIPT_SENT_ID
				  ,A.QST_CD
				  ,X.CENTERCD
				  ,A.CNTR_CD
				  ,X.CTRA_INSA_CLCD
				  ,X.USER_ID
				  ,X.ISTP_CD
				  ,X.ISTP_NM
				  ,X.PROD_CD
				  ,X.PROD_NM
				  ,X.TREATYHQCD
				  ,X.TREATYHQNM
				  ,X.TREATYBRHCD
				  ,X.TREATYBRHNM
				  ,X.TREATYDEPTCD
				  ,X.TREATYDEPTNM
				  ,X.S_CTRA_INSA_CLCD
			 FROM ms_script_sent A WITH(NOLOCK),
			 (SELECT DISTINCT A.CON_ENT_DGN_NO
			         ,A.PROD_CD
					 ,A.DMBO_CD
					 ,A.CTRA_INSA_CLCD
					 ,Items AS S_CTRA_INSA_CLCD
					 ,A.CON_CON_NA_Y_CNT
					 ,A.SC_LCLF_CD
					 ,A.CENTERCD
					 ,A.G_AGE
					 ,A.P_AGE
					 ,A.G_INSUR_AGE
					 ,A.P_INSUR_AGE
					 ,A.USER_ID
					 ,A.ISTP_CD
					 ,A.ISTP_NM
					 ,A.PROD_NM
					 ,(SELECT TREATYHQCD FROM ms_usermaster WHERE USER_ID = A.USER_ID) AS TREATYHQCD
				     ,(SELECT TREATYHQNM FROM ms_usermaster WHERE USER_ID = A.USER_ID) AS TREATYHQNM
					 ,(SELECT TREATYBRHCD FROM ms_usermaster WHERE USER_ID = A.USER_ID) AS TREATYBRHCD
					 ,(SELECT TREATYBRHNM FROM ms_usermaster WHERE USER_ID = A.USER_ID) AS TREATYBRHNM
					 ,(SELECT TREATYDEPTCD FROM ms_usermaster WHERE USER_ID = A.USER_ID) AS TREATYDEPTCD
					 ,(SELECT TREATYDEPTNM FROM ms_usermaster WHERE USER_ID = A.USER_ID) AS TREATYDEPTNM
					FROM ms_stt_meta A WITH(NOLOCK) outer apply dbo.fn_split_string(CTRA_INSA_CLCD, ',') 
					WHERE A.CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
			        AND STT_FLAG='Y' AND TA_FLAG='Y' AND GRD_FLAG='N'
				   -- AND A.CTRA_INSA_CLCD IN ( SELECT Items FROM dbo.fn_split_string(A.CTRA_INSA_CLCD, ','))
			       -- AND A.CON_ENT_DGN_NO='941806678003'  
			)X
			WHERE A.SC_SNO IN (SELECT SC_SNO FROM TB_SC_MNG WHERE USE_YN<>'N' AND PROD_CD = X.PROD_CD AND USE_YN='Y' AND CTRA_INSA_CLCD = X.S_CTRA_INSA_CLCD AND SC_LCLF_CD IN (SELECT Items FROM fn_split_string(X.SC_LCLF_CD,',')))
			AND A.CNTR_CD = (CASE WHEN (SELECT COUNT(SC_SNO) FROM ms_script_mng 
			                               WHERE SC_SNO IN (SELECT SC_SNO  FROM TB_SC_MNG WHERE USE_YN<>'N' AND PROD_CD = X.PROD_CD AND USE_YN='Y' AND CTRA_INSA_CLCD = X.S_CTRA_INSA_CLCD AND SC_LCLF_CD  IN (SELECT Items FROM fn_split_string(X.SC_LCLF_CD,','))) AND CNTR_CD = X.CENTERCD) = 0 THEN '00000' ELSE X.CENTERCD END )        
			AND (A.QST_KIND_CD = 'A' OR A.QST_KIND_CD ='E'
			     OR ( QST_CD IN (SELECT DISTINCT QST_CD FROM TB_QST_KIND_MNG WHERE QST_KIND_CD ='B' AND CNTR_CD = A.CNTR_CD AND QST_COND IN (SELECT Items FROM fn_split_string(X.DMBO_CD,',')) ) ) 
			     OR ( QST_CD IN (SELECT DISTINCT QST_CD FROM TB_QST_KIND_MNG WHERE QST_KIND_CD ='C' AND CNTR_CD = A.CNTR_CD AND QST_COND = X.P_INSUR_AGE) )
			     OR ( QST_CD IN (SELECT DISTINCT QST_CD FROM TB_QST_KIND_MNG WHERE QST_KIND_CD ='D' AND CNTR_CD = A.CNTR_CD AND QST_COND = X.CON_CON_NA_Y_CNT) )       
			     OR ( QST_CD IN (SELECT DISTINCT QST_CD FROM TB_QST_KIND_MNG WHERE QST_KIND_CD ='F' AND CNTR_CD = A.CNTR_CD AND QST_COND = X.G_AGE) )  
			     OR ( QST_CD IN (SELECT DISTINCT QST_CD FROM TB_QST_KIND_MNG WHERE QST_KIND_CD ='G' AND CNTR_CD = A.CNTR_CD AND QST_COND = X.G_AGE) ) )  
			AND (A.EXCEPT_YN = 'N' OR A.EXCEPT_YN IS NULL)
			AND A.DEL_YN='N'
			) RE ON S.SC_SNO = RE.SC_SNO
