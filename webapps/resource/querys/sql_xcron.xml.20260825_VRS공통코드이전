	<sql-service name='msens.xcron.hansol.systeminfocache_1' datasource='aig_rec' type='prepared'>
		<description>분석서버모니터링 데이터현황 조회</description>
		<result-name>msens.xcron.hansol.systeminfocache_1</result-name>
		<query><![CDATA[
			  
			SELECT REC.REC_CNT,
				     REC.REC_LAST_TIME,
				     STT.STT_CNT,
				     STT.STT_LAST_TIME
			  FROM (SELECT COUNT(1) AS REC_CNT, MAX(SUBSTRING(InsDate,9,6)) AS REC_LAST_TIME FROM Sponsor_Callinfo WITH(NOLOCK) WHERE TPANO <> '' AND LEFT(InsDate,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')) REC, 
				   (SELECT COUNT(1) AS STT_CNT, MAX(SUBSTRING(InsDate,9,6)) AS STT_LAST_TIME FROM Sponsor_Callinfo WITH(NOLOCK) WHERE TPANO <> '' AND LEFT(InsDate,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH') AND STT_FLAG = 'Y') STT 
        ]]></query>
	</sql-service>

	<sql-service name='msens.xcron.hansol.systeminfocache_2' datasource='is_stat' type='prepared'>
		<description>분석서버모니터링 데이터현황 조회</description>
		<result-name>msens.xcron.hansol.systeminfocache_2</result-name>
		<query><![CDATA[
			    SELECT META.META_CNT,
					   META.META_LAST_TIME,
					   TA.TA_CNT,
					   TA.TA_LAST_TIME,
					   SRC.SRC_CNT,
					   SRC.SRC_LAST_TIME,
					   ANL_N.ANL_N_CNT,
					   ANL_Y.ANL_Y_CNT,
					   ANL_Y.ANL_LAST_TIME
				FROM (SELECT COUNT(1) AS META_CNT, ISNULL(MAX(SUBSTRING(REG_DATE,9,6)), '000000') AS META_LAST_TIME FROM ms_stt_meta WITH(NOLOCK) WHERE LEFT(REG_DATE,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')) META,
					 (SELECT COUNT(1) AS ANL_N_CNT FROM ms_stt_meta WITH(NOLOCK) WHERE GRD_FLAG = 'N' AND LEFT(REG_DATE,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')) ANL_N,
					 (SELECT COUNT(1) AS ANL_Y_CNT,ISNULL(MAX(SUBSTRING(B.REG_DATE,9,6)), '000000') ANL_LAST_TIME FROM ms_grade_sum A ,ms_stt_meta B WITH(NOLOCK) WHERE A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO AND GRD_FLAG ='Y' AND LEFT(B.REG_DATE,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')) ANL_Y,
				 	 (SELECT COUNT(1) AS TA_CNT, ISNULL(MAX(SUBSTRING(TA_R_TIME,9,6)), '000000') AS TA_LAST_TIME FROM ms_stt_meta WITH(NOLOCK) WHERE TA_FLAG = 'Y' AND LEFT(TA_R_TIME,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')) TA, 
				     (SELECT COUNT(1) AS SRC_CNT, ISNULL(MAX(SUBSTRING(SRC_R_TIME,9,6)),'000000') AS SRC_LAST_TIME FROM ms_stt_meta WITH(NOLOCK) WHERE SRC_FLAG = 'Y' AND LEFT(SRC_R_TIME,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')) SRC 
        ]]></query>
	</sql-service>

	<sql-service name='msens.xcron.hansol.systeminfocache_3' datasource='aig_rec' type='prepared'>
		<description>분석서버모니터링 데이터현황 조회(녹취,STT, 미분석 데이터현황)</description>
		<result-name>msens.xcron.hansol.systeminfocache_3</result-name>
		<query><![CDATA[

			   SELECT RE.DATETIME,
					   MAX(RE.REC_CNT) AS REC_CNT,
					   MAX(RE.STT_CNT) AS STT_CNT
				FROM
				(
					SELECT SUBSTRING(InsDate,9,2) AS DATETIME
						 , COUNT(1) AS REC_CNT
						 , 0 AS STT_CNT
					FROM Sponsor_Callinfo WITH(NOLOCK)
					WHERE TPANO <> '' 
					AND LEFT(InsDate,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					GROUP BY SUBSTRING(InsDate,9,2)
				
					UNION ALL
				
					SELECT SUBSTRING(InsDate,9,2) AS DATETIME
						 , 0 AS REC_CNT
						 , COUNT(1) AS STT_CNT
					FROM Sponsor_Callinfo WITH(NOLOCK)
					WHERE TPANO <> '' 
					AND LEFT(InsDate,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					AND STT_FLAG = 'Y'
					GROUP BY SUBSTRING(InsDate,9,2)
				) RE
				GROUP BY DATETIME
				ORDER BY DATETIME

        ]]></query>
	</sql-service>

	<sql-service name='msens.xcron.hansol.systeminfocache_4' datasource='is_stat' type='prepared'>
		<description>분석서버모니터링 데이터현황 조회(TA,검색,GRADE 데이터현황)</description>
		<result-name>msens.xcron.hansol.systeminfocache_4</result-name>
		<query><![CDATA[

			      SELECT RE.DATETIME,
					   MAX(RE.META_CNT) META_CNT ,
					   MAX(RE.TA_CNT) AS TA_CNT,
					   MAX(RE.SRC_CNT) AS SRC_CNT,
					   MAX(RE.GRD_CNT) AS GRD_CNT,
					   MAX(RE.ANL_N_CNT) AS ANL_N_CNT
				FROM
				(
					SELECT SUBSTRING(REG_DATE,9,2) AS DATETIME
						 , COUNT(1) AS META_CNT
						 , 0 AS TA_CNT
						 , 0 AS SRC_CNT
						 , 0 AS GRD_CNT
						 , 0 AS ANL_N_CNT
					FROM ms_stt_meta WITH(NOLOCK)
					WHERE LEFT(REG_DATE,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					GROUP BY SUBSTRING(REG_DATE,9,2)
				
					UNION ALL
				
					SELECT SUBSTRING(TA_R_TIME,9,2) AS DATETIME
						 , 0 AS META_CNT
						 , COUNT(1) AS TA_CNT
						 , 0 AS SRC_CNT
						 , 0 AS GRD_CNT
						 , 0 AS ANL_N_CNT
					FROM ms_stt_meta WITH(NOLOCK)
					WHERE TA_FLAG = 'Y'
					AND LEFT(TA_R_TIME,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					GROUP BY SUBSTRING(TA_R_TIME,9,2)
				
					UNION ALL
				
					SELECT SUBSTRING(SRC_R_TIME,9,2) AS DATETIME
						 , 0 AS META_CNT
						 , 0 AS TA_CNT
						 , COUNT(1) AS SRC_CNT
						 , 0 AS GRD_CNT
						 , 0 AS ANL_N_CNT
					FROM ms_stt_meta WITH(NOLOCK)
					WHERE SRC_FLAG = 'Y'
					AND LEFT(SRC_R_TIME,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					GROUP BY SUBSTRING(SRC_R_TIME,9,2)
				
					UNION ALL
				
					SELECT SUBSTRING(SRC_R_TIME,9,2) AS DATETIME
						 , 0 AS META_CNT
						 , 0 AS TA_CNT
						 , 0 AS SRC_CNT
						 , COUNT(1)  AS GRD_CNT
						 , 0 AS ANL_N_CNT
					FROM ms_stt_meta m, ms_grade_sum g WITH(NOLOCK)
					WHERE m.CON_ENT_DGN_NO = g.CON_ENT_DGN_NO
					AND GRD_FLAG = 'Y'
					AND LEFT(g.REG_DATE,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					GROUP BY SUBSTRING(SRC_R_TIME,9,2)

					UNION ALL

					SELECT SUBSTRING(REG_DATE,9,2) AS DATETIME
						 , 0 AS META_CNT
						 , 0 AS TA_CNT
						 , 0 AS SRC_CNT
						 , 0 AS GRD_CNT
						 , COUNT(1) AS ANL_N_CNT
					FROM ms_stt_meta WITH(NOLOCK)
					WHERE LEFT(REG_DATE,10) BETWEEN format(GETDATE(),'yyyyMMdd')+'09' AND format(GETDATE(),'yyyyMMddHH')
					AND GRD_FLAG = 'N'
					GROUP BY SUBSTRING(REG_DATE,9,2)
				
				) RE
				GROUP BY RE.DATETIME
				ORDER BY DATETIME

        ]]></query>
	</sql-service>

