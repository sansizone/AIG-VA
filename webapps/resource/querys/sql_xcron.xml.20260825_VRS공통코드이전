	<sql-service name='msens.xcron.hansol.setsttencryptionwebaction_1' datasource='is_stat' type='prepared'>
		<description>STT 암호화 대상건 추출</description>
		<result-name>msens.xcron.hansol.setsttencryptionwebaction_1</result-name>
		<query><![CDATA[
			
			SELECT TOP(100) UCID,
							CONTENT
			FROM ms_stt_rslt_merge WITH(NOLOCK)
			WHERE UCID IN  (  SELECT RE.UCID
									FROM 
										(SELECT A.UCID,
											   CASE WHEN SUM(CASE WHEN A.STT_FLAG ='Y' AND A.TA_FLAG = 'Y' AND A.SRC_FLAG = 'Y' THEN 1 ELSE 0 END) = COUNT(UCID) THEN 'Y' ELSE 'N' END ENC_FLAG
										 FROM ms_stt_meta A WITH(NOLOCK),
											(SELECT RE.FILEID
											 FROM
											   (SELECT A.FILEID, A.BEF_UCID_CNT, ISNULL(B.UCID_CNT, 0) AS UCID_CNT
												 FROM 
													(SELECT FILEID, COUNT(FILEID) AS BEF_UCID_CNT
													 FROM ms_stt_bef_meta WITH(NOLOCK)
													 GROUP BY FILEID) A 
												  LEFT OUTER JOIN
													(SELECT UCID, COUNT(UCID) AS UCID_CNT
													 FROM ms_stt_meta WITH(NOLOCK)
													 GROUP BY UCID) B
												  ON A.FILEID = B.UCID
												) RE
											 WHERE RE.BEF_UCID_CNT = RE.UCID_CNT) B
										 WHERE A.UCID = B.FILEID
										 GROUP BY A.UCID
										) RE
									WHERE RE.ENC_FLAG = 'Y'
							   )
				WHERE ENC_FLAG = 'N'
        ]]></query>
	</sql-service>
	
