				 , QST_CNTS_P1
				 , QST_KIND_CD
				 , SORTKEY
				 , DEL_YN
				 , DEL_DATE
			FROM ms_script_mng			
			WHERE 1=1
			AND (R_FLAG = 'N' OR R_FLAG IS NULL)
			AND convert(varchar,QST_CNTS_P1) != ''
			ORDER BY CNTR_CD,QST_CD, QST_KIND_CD, SORTKEY
        ]]></query>
	</sql-service>

	<sql-service name='msens.xcron.hansol.getVRSParser2.ins2' datasource='is_stat' type='prepared' batch='true'>
		<description>AiGEN에서 넘어온 VRS 문장단위로 쪼개서 저장</description>
		<batch-name>finalVRSInfo</batch-name>
		<query><![CDATA[

					MERGE ms_script_sent AS A
					USING (SELECT 'X' AS DUAL) AS B
					ON (	 SC_SNO = ?SC_SNO
						 AND SC_LCLF_CD = ?SC_LCLF_CD
						 AND SC_SCLF_CD = ?SC_SCLF_CD
						 AND QST_CD = ?QST_CD
						 AND CNTR_CD = ?CNTR_CD
						 AND SCRIPT_SENT_ID = ?SEQ
					   )
					WHEN MATCHED THEN
						UPDATE SET 
						QST_CDNM = ?QST_CDNM,
						QST_KIND_CD = ?QST_KIND_CD,
						SCRIPT_SENT = ?SCRIPT_SENT,
						SCRIPT_TA_SENT = ?SCRIPT_TA_SENT,
						SORTKEY = ?SORTKEY,
						DEL_YN = ?DEL_YN,
						DEL_DATE = ?DEL_DATE,
						CHG_DATE = (format(getdate(),'yyyyMMddHHmmss'))
					WHEN NOT MATCHED THEN
						INSERT (
									SC_SNO,
									SC_LCLF_CD,
									SC_SCLF_CD,
									QST_CD,
									CNTR_CD,
									SCRIPT_SENT_ID,
									QST_CDNM,
									QST_KIND_CD,
									SCRIPT_SENT,
									SCRIPT_TA_SENT,
									QST_RATE,
									EXCEPT_YN,
									DEL_YN,
									DEL_DATE,
									SORTKEY
								) VALUES (
									?SC_SNO,
									?SC_LCLF_CD,
									?SC_SCLF_CD,
									?QST_CD,
									?CNTR_CD,
									?SEQ,
									?QST_CDNM,
									?QST_KIND_CD,
									?SCRIPT_SENT,
									?SCRIPT_TA_SENT,
									60,
									'N',
									?DEL_YN,
									?DEL_DATE,
									?SORTKEY
						);
        ]]></query>
	</sql-service>

