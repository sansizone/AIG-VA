	<sql-service name='msens.xcron.hansol.getrealtimeinfo_9' datasource='is_stat' type='prepared' batch='true'>
		<description>기존 분석 데이터 삭제하기</description>
		<batch-name>SttInteInfo</batch-name>
		<query><![CDATA[

			DECLARE
				@n_cnt INT
			BEGIN
			    DELETE FROM MS_GRADE_SUM WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
			    
			    DELETE FROM MS_REGU_FOCUS WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))

				DELETE FROM MS_REGU_OMIT WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
				
				DELETE FROM MS_REGU_SCORE WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
				
				DELETE FROM MS_REGU_SECRET WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
				
				DELETE FROM MS_REGU_SUM WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
				
				DELETE FROM MS_SEARCH_SUM WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
				
				DELETE FROM MS_STT_META WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO))
				
				DELETE FROM MS_SEARCH_SCORE WHERE UCID = ?UCID
				
				DELETE FROM MS_MENT_SCORE WHERE CON_ENT_DGN_NO = SUBSTRING(?TPANO,6,LEN(?TPANO)) AND UCID = ?UCID
				
				COMMIT;
			END;

        ]]></query>
	</sql-service>
	  
