	<sql-service name='msens.xcron.hansol.setautoassignwebaction_4' datasource='aig_tm' type='prepared'>
		<description>30일 이내 설계한 이력이 있는지 조회</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_4</result-name>
		<query><![CDATA[
			SELECT P.TM_UPDATE_PRE_QA, -- 할당된 QC
			       M.USE_YN, -- QC의 근무 여부
			       TM_UPDATE_PRE_JUDGE_DATE, -- 배당일자
			      (SELECT TREATYDEPTCD FROM TSOWN.TB_USER WHERE USERID = P.TM_UPDATE_PRE_QA) AS TREATYDEPTCD -- QC의 소속
			FROM
			    (SELECT CON_P_PSN_NO,
			           TM_UPDATE_PRE_QA,
			           CON_ENT_DGN_NO,
			           TM_UPDATE_PRE_JUDGE_DATE,
			           CON_APP_DATE,
			           (SELECT MAX(REG_DT) FROM TSOWN.TB_APP_ACT_HIST WHERE CON_ENT_DGN_NO = P.CON_ENT_DGN_NO AND APP_ACT = '120') AS P_CON_ENT_DGN_DATE, -- 과거 최근 설계일자
			           (SELECT MAX(REG_DT) FROM TSOWN.TB_APP_ACT_HIST WHERE CON_ENT_DGN_NO = ?CON_ENT_DGN_NO AND APP_ACT = '120') AS M_CON_ENT_DGN_DATE -- 해당 설계일자
			    FROM TSOWN.TB_INSU_PLAN_MAST P
			    WHERE P.CON_P_PSN_NO            = (SELECT CON_P_PSN_NO FROM TSOWN.TB_INSU_PLAN_MAST WHERE CON_ENT_DGN_NO = ?CON_ENT_DGN_NO)
			    AND (P.CON_P_PSN_NO IS NOT NULL OR P.CON_P_PSN_NO != '')
			    ) P, TSOWN.TB_PRE_EST_ALLOCATE_MNG M
			WHERE P.TM_UPDATE_PRE_QA        = M.USER_ID
			AND TM_UPDATE_PRE_QA IS NOT NULL
			AND (TRUNC(TO_DATE(M_CON_ENT_DGN_DATE,'YYYYMMDD')) - TRUNC(TO_DATE(P_CON_ENT_DGN_DATE,'YYYYMMDD'))) <= 30
			ORDER BY NVL(P.CON_APP_DATE, '00000000') DESC, NVL(P.TM_UPDATE_PRE_JUDGE_DATE, '00000000') DESC, P.TM_UPDATE_PRE_QA
        ]]></query>
	</sql-service>
	

	<sql-service name='msens.xcron.hansol.setautoassignwebaction_5' datasource='aig_tm' type='prepared'>
