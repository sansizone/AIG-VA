	<sql-service name='msens.xcron.hansol.getrealtimeinfo_3' datasource='is_stat' type='prepared' batch='true'>
		<description>녹취 분석 현황 정보 inert</description>
		<batch-name>SttInteInfo</batch-name>
		<query><![CDATA[

			MERGE ms_stt_bef_meta AS A
				USING (SELECT 'X' AS DUAL) AS B
				ON ( FILEID = ?FILEID AND UCID = ?UCID AND TPANO = ?TPANO)
				WHEN MATCHED THEN
					UPDATE SET 
					STT_FLAG = ?STT_FLAG,
					STT_ERR_CD = ?STT_ERR_CD,
					STT_R_TIME = ?STT_R_TIME,
					REG_DATE = format(GETDATE(),'yyyyMMddHHmmss'),
					CHG_DATE = format(GETDATE(),'yyyyMMddHHmmss')
				WHEN NOT MATCHED THEN
					INSERT(
						FILEID
					   ,UCID
					   ,SP_CODE
					   ,REC_START_DT
					   ,DURATION
					   ,AGENT_ID
					   ,TPANO
					   ,ORG_FILE_FULL_PATH
					   ,STT_FLAG
					   ,STT_ERR_CD
					   ,STT_R_TIME
					   ,BATCH_YN
					  )
					VALUES ( 
						?FILEID
					   ,?UCID
					   ,?SP_CODE
					   ,?REC_START_DT
					   ,?DURATION
					   ,?AGENT_ID
					   ,?TPANO
					   ,?ORG_FILE_FULL_PATH
					   ,?STT_FLAG
					   ,?STT_ERR_CD
					   ,?STT_R_TIME
					   ,?BATCH_YN
					);

        ]]></query>
	</sql-service>
	
