	<sql-service name='msens.xcron.hansol.setautoassignwebaction_14' datasource='is_stat' type='prepared' batch='true'>
		<description>MS_STT_META 테이블에 자동배분 결과 저장</description>
		<batch-name>alloc_List</batch-name>
		<query><![CDATA[
			UPDATE ms_stt_meta
			SET ASS_USER_ID = ?ASS_USER_ID,
				ASS_FLAG = 'Y',
				ASS_R_TIME = CASE WHEN LEN(?ASS_R_TIME) > 0 THEN ?ASS_R_TIME 
								  ELSE format(getdate(),'yyyyMMddHHmmss') END
			WHERE CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_15' datasource='is_stat' type='prepared' batch='true'>
		<description>자동배분 할당 오류발생시 flag 업데이트</description>
		<batch-name>AutoRollback</batch-name>
		<query><![CDATA[

			UPDATE ms_stt_meta
			SET ASS_FLAG = (CASE WHEN ASS_FLAG = 'S' THEN 'N' ELSE ASS_FLAG END),
				ASS_R_TIME =  (CASE WHEN ASS_FLAG = 'S' THEN NULL ELSE ASS_R_TIME END),
				ASS_USER_ID = (CASE WHEN ASS_FLAG = 'S' THEN NULL ELSE ASS_USER_ID END)
			WHERE CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
						
        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_16' datasource='is_stat' type='prepared' batch='false'>
		<description>업무 여부 조회</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_16</result-name>
		<query><![CDATA[

			SELECT MIN(ETC3) AS MIN_WORK_TIME, MAX(ETC4) AS MAX_WORK_TIME,
				   FORMAT(GETDATE(),'HHmm') AS NOW_TIME,
				   CASE WHEN MIN(ETC3) <= format(GETDATE(),'HHmm') AND MAX(ETC4) >= format(GETDATE(),'HHmm') THEN 'Y'
					    ELSE 'N' END AS WORK_YN,
				   COUNT(1) AS QC_ORG_CNT
			FROM ms_codebook WITH(NOLOCK)
			WHERE CODE_TYPE = 'SYS140'
			AND CODE_ID <> '00'
			AND USE_YN = 'Y'
			AND ETC2 LIKE CONCAT('%',?ORG_CD, '%')
						
        ]]></query>
	</sql-service>
	
	
	
	<sql-service name='msens.xcron.hansol.getdashboardwebaction_1' datasource='is_stat' type='prepared'>
		<description>대시보드-분석현황 조회</description>
		<result-name>msens.xcron.hansol.getdashboardwebaction_1</result-name>
		<query><![CDATA[
			
			SELECT RE.GUBUN,
				   RE.GUBUN_NM,
				   RE.TOT_CNT,
				   RE.ANAL_N_CNT,
				   RE.ANAL_Y_CNT,
				   ISNULL(RE.GRADE_1,0) GRADE_1,
				   ISNULL(RE.GRADE_2,0) GRADE_2,
				   ISNULL(RE.GRADE_3,0) GRADE_3,
				   ISNULL(RE.GRADE_4,0) GRADE_4,
				   ISNULL(RE.GRADE_5,0) GRADE_5,
				   ISNULL(RE.GRADE_6,0) GRADE_6,
				   ISNULL(RE.GRADE_7,0) GRADE_7,
				   ISNULL(RE.GRADE_8,0) GRADE_8,
				   ISNULL(RE.GRADE_9,0) GRADE_9,
				   ISNULL(RE.GRADE_10,0) GRADE_10
			FROM (	
				(SELECT 
								'01' AS GUBUN, 
								'당일현황' AS GUBUN_NM,
							   ISNULL(SUM(CASE WHEN ISNULL(STT_FLAG, 'N') = 'Y' THEN 1 ELSE 0 END), 0) AS TOT_CNT,
							   ISNULL(SUM(CASE WHEN ISNULL(GRD_FLAG,'N') = 'Y' THEN 1 ELSE 0 END),0) AS ANAL_Y_CNT,
							   ISNULL(SUM(CASE WHEN ISNULL(GRD_FLAG, 'N') = 'N' THEN 1 ELSE 0 END),0) AS ANAL_N_CNT,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '1' THEN 1 ELSE 0 END) AS GRADE_1,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '2' THEN 1 ELSE 0 END) AS GRADE_2,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '3' THEN 1 ELSE 0 END) AS GRADE_3,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '4' THEN 1 ELSE 0 END) AS GRADE_4,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '5' THEN 1 ELSE 0 END) AS GRADE_5,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '6' THEN 1 ELSE 0 END) AS GRADE_6,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '7' THEN 1 ELSE 0 END) AS GRADE_7,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '8' THEN 1 ELSE 0 END) AS GRADE_8,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '9' THEN 1 ELSE 0 END) AS GRADE_9,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '10' THEN 1 ELSE 0 END) AS GRADE_10
						FROM (SELECT DISTINCT CON_ENT_DGN_NO, STT_FLAG, GRD_FLAG 
						      FROM ms_stt_meta Z WITH(NOLOCK),(SELECT 
														ORG1_CD, 
														ORG1_NAME ORG1_NM, 
														ORG2_CD, 
														ORG2_NAME ORG2_NM,
														ORG3_CD, 
														ORG3_NAME ORG3_NM, 
														USER_ID, 
														USER_NAME USER_NM 
													FROM vw_usermaster) Y 
							  WHERE Z.USER_ID=Y.USER_ID
							  ?org1_cd
							  ?org2_cd
							  ?org3_cd
							  ?user_id
							  AND  LEFT(CON_ENT_DGN_DATE, 8) = FORMAT(GETDATE(), 'yyyyMMdd')) M LEFT OUTER JOIN ms_grade_sum S WITH(NOLOCK)
						ON M.CON_ENT_DGN_NO = S.CON_ENT_DGN_NO
						)
						
						UNION 
						
						(SELECT 
								'02' AS GUBUN,
								'전일현황' AS GUBUN_NM,
							   ISNULL(SUM(CASE WHEN ISNULL(STT_FLAG, 'N') = 'Y' THEN 1 ELSE 0 END), 0) AS TOT_CNT,
							   ISNULL(SUM(CASE WHEN ISNULL(GRD_FLAG,'N') = 'Y' THEN 1 ELSE 0 END),0) AS ANAL_Y_CNT,
							   ISNULL(SUM(CASE WHEN ISNULL(GRD_FLAG, 'N') = 'N' THEN 1 ELSE 0 END),0) AS ANAL_N_CNT,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '1' THEN 1 ELSE 0 END) AS GRADE_1,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '2' THEN 1 ELSE 0 END) AS GRADE_2,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '3' THEN 1 ELSE 0 END) AS GRADE_3,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '4' THEN 1 ELSE 0 END) AS GRADE_4,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '5' THEN 1 ELSE 0 END) AS GRADE_5,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '6' THEN 1 ELSE 0 END) AS GRADE_6,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '7' THEN 1 ELSE 0 END) AS GRADE_7,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '8' THEN 1 ELSE 0 END) AS GRADE_8,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '9' THEN 1 ELSE 0 END) AS GRADE_9,
							   SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '10' THEN 1 ELSE 0 END) AS GRADE_10
						FROM (SELECT CON_ENT_DGN_NO, STT_FLAG, GRD_FLAG FROM MS_STT_META Z WITH(NOLOCK)
							,(SELECT 
														ORG1_CD, 
														ORG1_NAME ORG1_NM, 
														ORG2_CD, 
														ORG2_NAME ORG2_NM,
														ORG3_CD, 
														ORG3_NAME ORG3_NM, 
														USER_ID, 
														USER_NAME USER_NM 
													FROM vw_usermaster) Y 
							  WHERE Z.USER_ID=Y.USER_ID
							  ?org1_cd
							  ?org2_cd
							  ?org3_cd
							  ?user_id
							  AND LEFT(CON_ENT_DGN_DATE, 8) = ( -- 전 영업일 구하는 쿼리(LEFT OUTER JOIN 이라 하위쿼리에서 비교)
							  												SELECT MAX(CASE WHEN SOLAR >= FORMAT(DATEADD(DAY, -14, GETDATE()), 'yyyyMMdd') AND SOLAR <= FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMMdd') THEN SOLAR ELSE 0 END)
							  												FROM MS_HOLIDAY_INFO
																			WHERE (SUBSTRING(SOLAR, 0, 7) = FORMAT(DATEADD(M, -1,GETDATE()), 'yyyyMM') OR SUBSTRING(SOLAR, 0, 7) = FORMAT(GETDATE(), 'yyyyMM'))
																		AND WEEK1 NOT IN ('0')
																		AND DETAIL IS NULL
									   	)
							   GROUP BY CON_ENT_DGN_NO, STT_FLAG, GRD_FLAG) M LEFT OUTER JOIN ms_grade_sum S WITH(NOLOCK)
								ON M.CON_ENT_DGN_NO = S.CON_ENT_DGN_NO
						)
						
						UNION
						
						(SELECT 
								'03' AS GUBUN,
								'당월현황' AS GUBUN_NM,
								ROUND(CONVERT(FLOAT, ISNULL(SUM(CASE WHEN ISNULL(STT_FLAG, 'N') = 'Y' THEN 1 ELSE 0 END), 0)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1), 2) AS TOT_CNT,
							    ROUND(CONVERT(FLOAT,ISNULL(SUM(CASE WHEN ISNULL(GRD_FLAG,'N') = 'Y' THEN 1 ELSE 0 END),0)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1), 2) AS ANAL_Y_CNT,
							    ROUND(CONVERT(FLOAT, ISNULL(SUM(CASE WHEN ISNULL(GRD_FLAG, 'N') = 'N' THEN 1 ELSE 0 END),0)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01',GETDATE())+1), 2) AS ANAL_N_CNT,
								ROUND(CONVERT(FLOAT, SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '1' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_1,
								ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '2' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_2,
							    ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '3' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_3,
							    ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '4' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_4,
							    ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '5' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01',GETDATE())+1),2) AS GRADE_5,
							    ROUND(CONVERT(FLOAT, SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '6' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_6,
								ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '7' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_7,
							    ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '8' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_8,
							    ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '9' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01', GETDATE())+1),2) AS GRADE_9,
							    ROUND(CONVERT(FLOAT,SUM(CASE WHEN ISNULL(S.CHG_GRADE, S.GRADE) = '10' THEN 1 ELSE 0 END)) / (DATEDIFF(D, FORMAT(GETDATE(), 'yyyyMM') + '01',GETDATE())+1),2) AS GRADE_10
						FROM (SELECT DISTINCT CON_ENT_DGN_NO, STT_FLAG, GRD_FLAG 
						      FROM ms_stt_meta Z WITH(NOLOCK),(SELECT 
														ORG1_CD, 
														ORG1_NAME ORG1_NM, 
														ORG2_CD, 
														ORG2_NAME ORG2_NM,
														ORG3_CD, 
														ORG3_NAME ORG3_NM, 
														USER_ID, 
														USER_NAME USER_NM 
													FROM vw_usermaster) Y 
							  WHERE Z.USER_ID=Y.USER_ID
							  ?org1_cd
							  ?org2_cd
							  ?org3_cd
							  ?user_id
							  AND  LEFT(CON_ENT_DGN_DATE, 6) = FORMAT(GETDATE(), 'yyyyMM')) M LEFT OUTER JOIN ms_grade_sum S WITH(NOLOCK)
						ON M.CON_ENT_DGN_NO = S.CON_ENT_DGN_NO
						)
			) RE
			ORDER BY RE.GUBUN
        ]]></query>
        	<parameter name='org1_cd' value="AND Y.ORG1_CD = ?ORG1_CD" default="" />
			<parameter name='org2_cd' value="AND Y.ORG2_CD = ?ORG2_CD" default="" />
			<parameter name='org3_cd' value="AND Y.ORG3_CD = ?ORG3_CD" default="" />
			<parameter name='user_id' value="AND Z.USER_ID = ?USER_ID" default="" />
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.getdashboardwebaction_2' datasource='is_stat' type='prepared'>
		<description>대시보드- GRADE 평균 점수 조회</description>
		<result-name>msens.xcron.hansol.getdashboardwebaction_2</result-name>
		<query><![CDATA[
			SELECT MAX(GRD_NOW_SCORE) AS GRD_NOW_SCORE, 
				   MAX(GRD_YESTER_SCORE) AS GRD_YESTER_SCORE,
				   MAX(GRD_MON_SCORE) AS GRD_MON_SCORE
			FROM (
			SELECT 
				   ROUND(AVG(GRADE_SUM),2) AS GRD_NOW_SCORE,
				   0 AS GRD_YESTER_SCORE,
				   0 AS GRD_MON_SCORE
			FROM ms_grade_sum G,
				(SELECT DISTINCT CON_ENT_DGN_NO FROM MS_STT_META Z WITH(NOLOCK),(SELECT 
														ORG1_CD, 
														ORG1_NAME ORG1_NM, 
														ORG2_CD, 
														ORG2_NAME ORG2_NM,
														ORG3_CD, 
														ORG3_NAME ORG3_NM, 
														USER_ID, 
														USER_NAME USER_NM 
													FROM vw_usermaster) Y 
							  WHERE Z.USER_ID=Y.USER_ID
							  ?org1_cd
							  ?org2_cd
							  ?org3_cd
							  ?user_id
							  AND  LEFT(CON_ENT_DGN_DATE, 8) = FORMAT(GETDATE(), 'yyyyMMdd')) M
			WHERE G.CON_ENT_DGN_NO = M.CON_ENT_DGN_NO
			
			UNION 
			
			SELECT 0 AS GRA_NOW_SCORE,
				   ROUND(AVG(GRADE_SUM),2) AS GRD_YESTER_SCORE,
				   0 AS GRD_MON_SCORE
			FROM ms_grade_sum G,
				(SELECT CON_ENT_DGN_NO, CON_ENT_DGN_DATE FROM MS_STT_META Z WITH(NOLOCK),(SELECT 
														ORG1_CD, 
														ORG1_NAME ORG1_NM, 
														ORG2_CD, 
														ORG2_NAME ORG2_NM,
														ORG3_CD, 
														ORG3_NAME ORG3_NM, 
														USER_ID, 
														USER_NAME USER_NM 
													FROM vw_usermaster) Y 
							  WHERE Z.USER_ID=Y.USER_ID
							  ?org1_cd
							  ?org2_cd
							  ?org3_cd
							  ?user_id
							  GROUP BY CON_ENT_DGN_NO,CON_ENT_DGN_DATE) M 
			WHERE G.CON_ENT_DGN_NO = M.CON_ENT_DGN_NO
			AND LEFT(CON_ENT_DGN_DATE, 8) = ( --전 영업일 구하는 쿼리
							  												SELECT MAX(CASE WHEN SOLAR >= FORMAT(DATEADD(DAY, -14, GETDATE()), 'yyyyMMdd') AND SOLAR <= FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMMdd') THEN SOLAR ELSE 0 END)
