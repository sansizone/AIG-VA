	<sql-service name='msens.xcron.hansol.setsttmetawebaction_4' datasource='aig_tm' type='prepared'>
		<description>설계번호로 AiGEN 정보 조회</description>
		<result-name>msens.xcron.hansol.setsttmetawebaction_4</result-name>
		<query><![CDATA[
			
			SELECT RE.CON_ENT_DGN_NO,
			       RE.CON_ENT_DGN_DATE,
			       CASE WHEN RE.CON_ENT_DGN_DATE IS NOT NULL AND RE.OPEN_INPUT_DATE IS NOT NULL
			            THEN MONTHS_BETWEEN(TO_DATE(SUBSTR(RE.CON_ENT_DGN_DATE,0,6)||'01','YYYYMMDD'), TO_DATE(SUBSTR(RE.OPEN_INPUT_DATE,0,6)||'01','YYYYMMDD'))+1 
			            ELSE NULL
			       END AS WORK_MONTH,
			       RE.CON_P_CONT_NAME,
			       RE.CON_CON_MONTH_PREM,
			       RE.CON_CON_OLT_DEPOSIT_NM,
			       RE.CON_IP_ISD_NAME,
			       RE.CON_CON_NA_Y_CNT,
			       RE.TM_NO,
			       RE.PROD_CD,
			       RE.PROD_NM, 
			       RE.DMBO_CD,
			       RE.INSUR_AMT,
			       RE.BASIC_PREM,
			       RE.CTRA_INSA_CLCD,
			       RE.G_AGE,
			       RE.P_AGE,
			       RE.USER_ID,
			       RE.CENTERCD,
			       RE.TM_UPDATE_PRE_QA,
			       RE.TM_UPDATE_PRE_JUDGE_DATE,
			       RE.CON_APP_DATE
			FROM
			(SELECT  m.CON_ENT_DGN_NO,
				   				(SELECT MAX(CONCAT(REG_DT, REG_TM)) FROM TSOWN.tb_app_act_hist WHERE CON_ENT_DGN_NO = m.CON_ENT_DGN_NO AND APP_ACT = '120') AS CON_ENT_DGN_DATE,
			                    (SELECT OPEN_INPUT_DATE FROM TSOWN.TB_TMR_ID_CREATE TMR WHERE TMR.USERID = m.TM_TMR_ID) AS OPEN_INPUT_DATE,
				   				m.CON_P_CONT_NAME,
								m.CON_CON_MONTH_PREM,
								m.CON_CON_OLT_DEPOSIT_NM,
								d.CON_IP_ISD_NAME,
								m.CON_CON_NA_Y_CNT,
								m.TM_NO,
								m.CON_I_KIND_CD AS PROD_CD,
			                   (SELECT ITEM_NAME FROM TSOWN.TBIA101 WHERE ITEM_CD = m.CON_I_KIND_CD) AS PROD_NM, 
			                   NVL( (SELECT LISTAGG(DMBO_CD, ',') WITHIN GROUP (ORDER BY DMBO_CD) FROM TSOWN.TBIC063 TB WHERE TB.TM_NO = m.TM_NO GROUP BY TB.TM_NO),'') AS DMBO_CD,
			                   NVL( (SELECT LISTAGG(INSUR_AMT, ',') WITHIN GROUP (ORDER BY DMBO_CD) FROM TSOWN.TBIC063 TB WHERE TB.TM_NO = m.TM_NO GROUP BY TB.TM_NO),'') AS INSUR_AMT,
			                   NVL( (SELECT LISTAGG(BASIC_PREM, ',') WITHIN GROUP (ORDER BY DMBO_CD) FROM TSOWN.TBIC063 TB WHERE TB.TM_NO = m.TM_NO GROUP BY TB.TM_NO),'') AS BASIC_PREM,
							   CASE WHEN m.CON_P_CONT_NAME = d.CON_IP_ISD_NAME AND (SELECT CON_FAMAILY_GB FROM TSOWN.TB_INSU_PLAN_PA_AUTH WHERE TM_NO = d.TM_NO AND CON_IP_INS_AIM_SEQ = d.CON_IP_INS_AIM_SEQ) = 1 THEN 'D,E'  
							    	 WHEN m.CON_P_CONT_NAME = d.CON_IP_ISD_NAME THEN 'A' -- CON_FAMAILY_GB != '1'
								     WHEN m.CON_P_CONT_NAME != d.CON_IP_ISD_NAME THEN 'B,C' -- CON_FAMAILY_GB == '1'
			                   END AS CTRA_INSA_CLCD,
							   PLS_DECRYPT_B64(m.CON_P_PSN_NO) AS G_AGE,
							   PLS_DECRYPT_B64(d.CON_IP_ISD_CD) AS P_AGE,
							   m.TM_TMR_ID AS USER_ID,
							   (SELECT HR_GROUP_CD FROM TSOWN.TB_GROUP_INFO WHERE GROUP_TYPE = '04' AND GROUP_CD = m.CENTERCD) AS CENTERCD,
							   m.TM_UPDATE_PRE_QA,
							   m.TM_UPDATE_PRE_JUDGE_DATE,
							   m.CON_APP_DATE
						FROM TSOWN.TB_INSU_PLAN_MAST m, TSOWN.TB_INSU_PLAN_DETAIL d
						WHERE m.TM_NO = d.TM_NO
			            AND m.CON_ENT_DGN_NO = ?con_ent_dgn_no
			) RE

        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setsttmetawebaction_4_test' datasource='aig_tm' type='simple'>
		<description>설계번호로 AiGEN 정보 조회</description>
		<result-name>msens.xcron.hansol.setsttmetawebaction_4</result-name>
		<query><![CDATA[
			
			SELECT RE.CON_ENT_DGN_NO,
			       RE.CON_ENT_DGN_DATE,
			       CASE WHEN RE.CON_ENT_DGN_DATE IS NOT NULL AND RE.OPEN_INPUT_DATE IS NOT NULL
			            THEN MONTHS_BETWEEN(TO_DATE(SUBSTR(RE.CON_ENT_DGN_DATE,0,6)||'01','YYYYMMDD'), TO_DATE(SUBSTR(RE.OPEN_INPUT_DATE,0,6)||'01','YYYYMMDD'))+1 
			            ELSE NULL
			       END AS WORK_MONTH,
			       RE.CON_P_CONT_NAME,
			       RE.CON_CON_MONTH_PREM,
			       RE.CON_CON_OLT_DEPOSIT_NM,
			       RE.CON_IP_ISD_NAME,
			       RE.CON_CON_NA_Y_CNT,
			       RE.TM_NO,
			       RE.PROD_CD,
			       RE.PROD_NM, 
			       RE.DMBO_CD,
			       RE.INSUR_AMT,
			       RE.BASIC_PREM,
			       RE.CTRA_INSA_CLCD,
			       RE.G_AGE,
			       RE.ENC_G_AGE,
			       RE.P_AGE,
			       RE.ENC_P_AGE,
			       RE.USER_ID,
			       RE.CENTERCD
			FROM
			(SELECT  m.CON_ENT_DGN_NO,
				   				(SELECT MAX(CONCAT(REG_DT, REG_TM)) FROM TSOWN.tb_app_act_hist WHERE CON_ENT_DGN_NO = m.CON_ENT_DGN_NO AND APP_ACT = '120') AS CON_ENT_DGN_DATE,
			                    (SELECT OPEN_INPUT_DATE FROM TSOWN.TB_TMR_ID_CREATE TMR WHERE TMR.USERID = m.TM_TMR_ID) AS OPEN_INPUT_DATE,
				   				m.CON_P_CONT_NAME,
								m.CON_CON_MONTH_PREM,
								m.CON_CON_OLT_DEPOSIT_NM,
								d.CON_IP_ISD_NAME,
								m.CON_CON_NA_Y_CNT,
								m.TM_NO,
								m.CON_I_KIND_CD AS PROD_CD,
			                   (SELECT ITEM_NAME FROM TSOWN.TBIA101 WHERE ITEM_CD = m.CON_I_KIND_CD) AS PROD_NM, 
			                   NVL( (SELECT LISTAGG(DMBO_CD, ',') WITHIN GROUP (ORDER BY DMBO_CD) FROM TSOWN.TBIC063 TB WHERE TB.TM_NO = m.TM_NO GROUP BY TB.TM_NO),'') AS DMBO_CD,
			                   NVL( (SELECT LISTAGG(INSUR_AMT, ',') WITHIN GROUP (ORDER BY INSUR_AMT) FROM TSOWN.TBIC063 TB WHERE TB.TM_NO = m.TM_NO GROUP BY TB.TM_NO),'') AS INSUR_AMT,
			                   NVL( (SELECT LISTAGG(BASIC_PREM, ',') WITHIN GROUP (ORDER BY BASIC_PREM) FROM TSOWN.TBIC063 TB WHERE TB.TM_NO = m.TM_NO GROUP BY TB.TM_NO),'') AS BASIC_PREM,
							   CASE WHEN m.CON_P_CONT_NAME = d.CON_IP_ISD_NAME AND (SELECT CON_FAMAILY_GB FROM TSOWN.TB_INSU_PLAN_PA_AUTH WHERE TM_NO = d.TM_NO AND CON_IP_INS_AIM_SEQ = d.CON_IP_INS_AIM_SEQ) = 1 THEN 'D,E'  
							    	 WHEN m.CON_P_CONT_NAME = d.CON_IP_ISD_NAME THEN 'A' -- CON_FAMAILY_GB != '1'
								     WHEN m.CON_P_CONT_NAME != d.CON_IP_ISD_NAME THEN 'B,C' -- CON_FAMAILY_GB == '1'
			                   END AS CTRA_INSA_CLCD,
							   PLS_DECRYPT_B64(m.CON_P_PSN_NO) AS G_AGE,
							   m.CON_P_PSN_NO AS ENC_G_AGE,
							   PLS_DECRYPT_B64(d.CON_IP_ISD_CD) AS P_AGE,
							   d.CON_IP_ISD_CD AS ENC_P_AGE,
							   m.TM_TMR_ID AS USER_ID,
							   (SELECT HR_GROUP_CD FROM TSOWN.TB_GROUP_INFO WHERE GROUP_TYPE = '04' AND GROUP_CD = m.CENTERCD) AS CENTERCD
						FROM TSOWN.TB_INSU_PLAN_MAST m, TSOWN.TB_INSU_PLAN_DETAIL d
						WHERE m.TM_NO = d.TM_NO
			            AND m.CON_ENT_DGN_NO IN (?con_ent_dgn_no)
			) RE

        ]]></query>
	</sql-service>

