		<description>AiGEN에서 넘어온VRS</description>
		<result-name>msens.xcron.hansol.getVRSParser.sel</result-name>
		<query><![CDATA[
			SELECT TOP(1500) A.SC_SNO, 
						   A.SC_LCLF_CD, 
