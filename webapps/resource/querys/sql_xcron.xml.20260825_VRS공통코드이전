	<sql-service name='msens.xcron.hansol.getmrlscallwebaction_8' datasource='is_stat' type='prepared' batch='true'>
		<description>ms_mrls_list 테이블에 최종 데이터 insert</description>
		<batch-name>MRLSLIST</batch-name>
		<query><![CDATA[
					MERGE ms_mrls_list AS A
					USING (SELECT 'X' AS DUAL) AS B
					ON ( 	 CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
							AND UCID = ?UCID
						)
					WHEN MATCHED THEN
						UPDATE SET 
						REG_DT = (CASE WHEN ?REG_DT > REG_DT THEN REG_DT ELSE ?REG_DT END),
						MR_CODE = ?MR_CODE,
						LS_CODE = ?LS_CODE,
						CENTER_CD = ?CENTER_CD,
						CENTER_NM = ?CENTER_NM,
						AGENT_ID = (CASE WHEN ?AGENT_ID IS NOT NULL THEN ?AGENT_ID ELSE AGENT_ID END),
						AGENT_NM = (CASE WHEN ?AGENT_NM IS NOT NULL THEN ?AGENT_NM ELSE AGENT_NM END),
						CUST_ID = (CASE WHEN ?CUST_ID IS NOT NULL THEN ?CUST_ID ELSE CUST_ID END),
						CON_IP_PSN_NAME = (CASE WHEN ?CON_IP_PSN_NAME IS NOT NULL THEN ?CON_IP_PSN_NAME ELSE CON_IP_PSN_NAME END),
						BIRTH_DT = (CASE WHEN ?BIRTH_DT IS NOT NULL THEN ?BIRTH_DT ELSE BIRTH_DT END),
						REC_YN = ?REC_YN,
						PASS_YN = ?PASS_YN,
						CHG_ID = 'SYSTEM',
						CHG_DATE =  format(GETDATE(),'yyyyMMddHHmmss')
					WHEN NOT MATCHED THEN
				    	INSERT (
							CON_ENT_DGN_NO
							,UCID
							,REG_DT
							,MR_CODE
							,LS_CODE
							,CENTER_CD
							,CENTER_NM
							,AGENT_ID
							,AGENT_NM
							,CUST_ID
							,CON_IP_PSN_NAME
							,BIRTH_DT
							,REC_YN
							,PASS_YN
							,REG_ID
							,REG_DATE
							,CHG_ID
							,CHG_DATE
						)
						VALUES
						(
							?CON_ENT_DGN_NO
							,?UCID
							,?REG_DT
							,?MR_CODE
							,?LS_CODE
							,?CENTER_CD
							,?CENTER_NM
							,?AGENT_ID
							,?AGENT_NM
							,?CUST_ID
							,?CON_IP_PSN_NAME
							,?BIRTH_DT
							,?REC_YN
							,?PASS_YN
							,'SYSTEM'
							,format(getDate(),'yyyyMMddHHmmss')
							,'SYSTEM'
							,format(getDate(),'yyyyMMddHHmmss')
						);
        ]]></query>
	</sql-service>
	
