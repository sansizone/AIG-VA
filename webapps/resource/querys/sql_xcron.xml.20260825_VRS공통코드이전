	<sql-service name='msens.xcron.hansol.setautoassignwebaction_6' datasource='is_stat' type='prepared'>
		<description>자동배분 대상 센터들 조회해오기</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_6</result-name>
		<query><![CDATA[
			SELECT CODE_ID, 
				   CODE_NAME, 
				   ETC1 AS QC_ORG_CD,
				   (SELECT COUNT(1) FROM ms_codebook WITH(NOLOCK) WHERE CODE_TYPE = 'SYS140' AND ETC2 LIKE CONCAT('%',?ORG_CD, '%')) as QC_CNT,
				   (SELECT ISNULL(ETC3,ETC2) FROM ms_codebook WITH(NOLOCK) WHERE CODE_TYPE = 'SYS141' AND ETC1 = C.ETC1) AS MAX_ASS_CNT
			FROM ms_codebook C
			WHERE CODE_TYPE = 'SYS140'
			AND CODE_ID <> '00'
			AND USE_YN = 'Y'
			AND ETC2 LIKE CONCAT('%',?ORG_CD, '%')
			?WORK_YN
        ]]></query>
        <parameter name='WORK_YN' value="" default="" >
			<condition key="Y" value="AND (ETC3 &lt;= FORMAT(GETDATE(),'HHmm') AND ETC4 &gt;= FORMAT(GETDATE(),'HHmm'))"/>
			<condition key="N" value="AND ETC5 = 'Y'"/>
		</parameter> 
	</sql-service>
	
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_7' datasource='is_stat' type='prepared' batch='false'>
		<description>업무시간이 되면 다시 원래대로 초기화 시킨다</description>
		<query><![CDATA[		
				UPDATE A
				SET ETC5 = (CASE WHEN ETC3 = UPD_ETC3 THEN 'Y'
								 WHEN ETC3 = CUR_ETC3 THEN 'N'
							ELSE 'N' END )
				FROM MS_CODEBOOK A,
					 (
						SELECT A.ETC2, 
							   MIN(A.ETC3) AS UPD_ETC3 , MIN(B.ETC3) AS CUR_ETC3				   
						FROM MS_CODEBOOK A WITH(NOLOCK) 
						LEFT OUTER JOIN 
						(SELECT ETC2, ETC3 FROM MS_CODEBOOK WITH(NOLOCK) WHERE CODE_TYPE = 'SYS140'
						AND CODE_ID <> '00' AND ETC5 = 'Y') B 
						ON A.ETC2 = B.ETC2
						WHERE CODE_TYPE = 'SYS140'
						AND CODE_ID <> '00'
						AND USE_YN = 'Y'
						GROUP BY A.ETC2
					 ) B
				WHERE CODE_TYPE = 'SYS140'
				AND CODE_ID <> '00'
				AND A.ETC2 = B.ETC2
				
				
				UPDATE ms_codebook 
				SET ETC3 = CONVERT(INT, ETC2)
				WHERE CODE_TYPE = 'SYS141'
				AND CODE_ID <> '00'
				AND USE_YN = 'Y'

        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_8' datasource='aig_tm' type='prepared' batch='false'>
		<description>센터별 배정 건수 체크(야간에만 도는 케이스)</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_8</result-name>
		<query><![CDATA[
			SELECT  TREATYDEPTCD
				   ,COUNT(DISTINCT CON_ENT_DGN_NO) AS NOT_PROC_CNT
			FROM TSOWN.TB_USER A
				,TSOWN.TB_PRE_EST_ALLOCATE_MNG B
				,(SELECT T1.TM_UPDATE_PRE_QA
						,T1.TM_PROCESSING_GB
						,T1.TM_NO
						,T1.CON_ENT_DGN_NO
						,T1.TM_UPDATE_PRE_JUDGE_DATE
				  FROM TSOWN.TB_INSU_PLAN_MAST T1
				  WHERE (TM_UPDATE_PRE_JUDGE_DATE BETWEEN ?BEF_WORK_DATE AND ?NOW_WORK_DATE)
				  AND   T1.TM_UPDATE_PRE_QA IS NOT NULL
                  AND TM_PROCESSING_GB IN ('46','47','48')
				 ) C
			WHERE    A.USED_ST != '3'
			AND      B.USE_YN = 'Y'
			AND      B.QACD = '01'
			AND      A.USERID = B.USER_ID
			AND      B.USER_ID = C.TM_UPDATE_PRE_QA(+)
			AND      A.TREATYDEPTCD  = ?ORG_CD
			GROUP BY TREATYDEPTCD
						
        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_9' datasource='is_stat' type='prepared' batch='false'>
		<description>현재 배분 대상자가 설계건수가 넘어버려서 다음 대상자로 변경합니다.</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_9</result-name>
		<query><![CDATA[
		
			SELECT CODE_TYPE, CODE_ID, ETC1 AS QC_ORG_CD
			FROM ms_codebook
			WHERE CODE_TYPE = 'SYS140'
			AND CODE_ID <> '00'
			AND USE_YN = 'Y'
			AND ETC5 <> 'Y'
			AND ETC2 LIKE CONCAT('%',?ORG_CD, '%')
			AND ETC3 = (SELECT TOP(1) A.ETC3
						FROM 
							(SELECT CODE_ID, ETC1, ETC2, ETC3, (CONVERT(INT, ETC3) / CONVERT(INT, ETC2)) AS ASS_CNT 
							FROM MS_CODEBOOK 
							WHERE CODE_TYPE = 'SYS140'
							AND ETC2 LIKE CONCAT('%',?ORG_CD, '%')
							AND CODE_ID <> '00'
							AND USE_YN = 'Y'
							AND ETC5 <> 'Y'
							) A, 
							(
								SELECT CODE_ID, ETC1, ETC2, ETC3
								FROM MS_CODEBOOK 
								WHERE CODE_TYPE = 'SYS141'
								AND CODE_ID <> '00'
								AND USE_YN = 'Y'
							) B
						WHERE A.ETC1 = B.ETC1
						ORDER BY  (CONVERT(INT, B.ETC3) / CONVERT(INT, B.ETC2)) ASC, A.ETC1 ASC)
        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_10' datasource='is_stat' type='simple' batch='false'>
		<description>다음 야간 배분 대상자를 Y로 업데이트 한다</description>
		<query><![CDATA[
				UPDATE ms_codebook
				SET ETC3 = (CONVERT(INT, ETC2) + CONVERT(INT, ETC3))
				WHERE CODE_TYPE = 'SYS141'
				AND ETC1 IN (SELECT ETC1 FROM ms_codebook WHERE CODE_TYPE = 'SYS140' AND ETC2 LIKE CONCAT('%','?org_cd', '%') AND ETC5 = 'Y')
				
				UPDATE ms_codebook
				SET ETC5 = (CASE WHEN ETC1 IN ( ?qc_org_cd ) THEN 'Y' ELSE 'N' END)  
				WHERE CODE_TYPE = 'SYS140'
				AND CODE_ID <> '00'
				AND ETC2 LIKE CONCAT('%','?org_cd', '%')

        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_11' datasource='is_stat' type='prepared'>
		<description>전영업일 조회</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_11</result-name>
		<query><![CDATA[
			SELECT MAX(CASE WHEN SOLAR >= FORMAT(DATEADD(DAY, -14, GETDATE()), 'yyyyMMdd') AND SOLAR <= FORMAT(DATEADD(DAY, -1, GETDATE()), 'yyyyMMdd') THEN SOLAR ELSE 0 END) AS BEF_WORK_DATE,
				   MAX(CASE WHEN SOLAR >= FORMAT(DATEADD(DAY, -14, GETDATE()), 'yyyyMMdd') AND SOLAR <= FORMAT(GETDATE(), 'yyyyMMdd') THEN SOLAR ELSE 0 END) AS NOW_WORK_DATE
			FROM MS_HOLIDAY_INFO with(nolock)
			WHERE (SUBSTRING(SOLAR, 0, 7) = FORMAT(DATEADD(M, -1,GETDATE()), 'yyyyMM') OR SUBSTRING(SOLAR, 0, 7) = FORMAT(GETDATE(), 'yyyyMM'))
			AND WEEK1 NOT IN ('0')
			AND DETAIL IS NULL
        ]]></query>
	</sql-service>
	
	
	<sql-service name='msens.xcron.hansol.setautoassignwebaction_12' datasource='aig_tm' type='simple'>
		<description>해당 설계번호를 배분할 QC를 조회</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_12</result-name>
		<query><![CDATA[
				   SELECT  A.USERID
									 ,SUM(CASE WHEN C.TM_PROCESSING_GB  IN ('46','47','48') AND A.USERID = C.TM_UPDATE_PRE_QA THEN 1 ELSE 0 END) AS NOT_PROC_CNT
					                 ,SUM(CASE WHEN C.ESTREGISTDT = '?NOW_WORK_DATE' AND C.TM_PROCESSING_GB NOT IN ('46','47','48') AND A.USERID = C.TM_UPDATE_PRE_QA THEN 1 ELSE 0 END) AS PROC_CNT
					                 ,SUM(CASE WHEN C.TM_UPDATE_PRE_JUDGE_DATE = '?NOW_WORK_DATE' AND A.USERID = C.TM_UPDATE_PRE_QA THEN 1 ELSE 0 END) AS TOT_CNT
					                 ,SUM(CASE WHEN C.TM_UPDATE_PRE_JUDGE_DATE = '?NOW_WORK_DATE' AND A.USERID = C.TM_UPDATE_PRE_QA AND C.GRADE = '?GRADE' THEN 1 ELSE 0 END) AS GRD_CNT
					                 ,ALLO_NUM
							  FROM TSOWN.TB_USER A
							        ,TSOWN.TB_PRE_EST_ALLOCATE_MNG B
								    ,(SELECT T1.TM_UPDATE_PRE_QA -- 배정QC
								          ,T1.TM_PROCESSING_GB -- 심사상태코드
								          ,T1.TM_UPDATE_PRE_JUDGE_DATE -- 배정일자
								          ,T1.TM_NO -- TM_NO
								          ,T1.CON_ENT_DGN_NO -- 설계번호
								          ,NVL(T2.ALTR_GRADE, T2.GRADE) AS GRADE -- 등급
								          ,T1.ESTREGISTDT -- 심사일자
								      FROM (SELECT T1.TM_UPDATE_PRE_QA
									            ,T1.TM_PROCESSING_GB
									            ,T1.TM_NO
									            ,T1.CON_ENT_DGN_NO
									            ,T1.TM_UPDATE_PRE_JUDGE_DATE
									            ,(SELECT SUBSTR(NVL(ESTREGISTDT,''),0,8) FROM TSOWN.TB_PRE_EST_HISTORY H WHERE H.CON_ENT_DGN_NO = T1.CON_ENT_DGN_NO AND HTDGREE = 1) AS ESTREGISTDT
										    FROM TSOWN.TB_INSU_PLAN_MAST T1
										    WHERE (TM_UPDATE_PRE_JUDGE_DATE BETWEEN '?BEF_WORK_DATE' AND '?NOW_WORK_DATE')
										    AND   T1.TM_UPDATE_PRE_QA IS NOT NULL
								    	   ) T1, TSOWN.TB_VA_GRADE_RSLT T2
								      WHERE T1.CON_ENT_DGN_NO = T2.ENTR_DSGN_NO(+)
								    ) C
							WHERE    A.USED_ST != '3'
							AND      B.USE_YN = 'Y'
							AND      B.QACD = '01'
							AND      A.USERID = B.USER_ID
							AND      B.USER_ID = C.TM_UPDATE_PRE_QA(+)
							AND      A.TREATYDEPTCD IN (?QC_ORG_CD)
							GROUP BY A.USERID, ALLO_NUM
							ORDER BY NOT_PROC_CNT ASC, PROC_CNT ASC, TOT_CNT ASC, GRD_CNT ASC, ALLO_NUM ASC
        ]]></query>
	</sql-service>

	<sql-service name='msens.xcron.hansol.setautoassignwebaction_13' datasource='aig_tm' type='prepared' batch='true'>
