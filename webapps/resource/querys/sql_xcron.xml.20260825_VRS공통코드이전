	<sql-service name='msens.xcron.hansol.setgraderesultwebaction_5' datasource='is_stat' type='prepared'>
		<description>Grade 대상자 결과 조회해오기</description>
		<result-name>msens.xcron.hansol.setgraderesultwebaction_5</result-name>
		<query><![CDATA[
			
			SELECT A.CON_ENT_DGN_NO,
				   ISNULL(MAX(A.SCORE_01),0) AS SCORE_01,
				   ISNULL(MAX(A.SCORE_02),0) AS SCORE_02,
				   ISNULL(MAX(A.SCORE_03),0) AS SCORE_03,
				   ISNULL(MAX(A.SCORE_04),0) AS SCORE_04,
				   ISNULL(MAX(A.SCORE_05),0) AS SCORE_05,
				   ISNULL(MAX(A.SCORE_06),0) AS SCORE_06
			FROM(
			SELECT 
				   CON_ENT_DGN_NO,
				   CASE WHEN LEN(CTRA_INSA_CLCD) < 2 THEN SCORE1
						WHEN LEN(CTRA_INSA_CLCD) > 1 AND SCORE1 > SCORE2 THEN SCORE2
						WHEN LEN(CTRA_INSA_CLCD) > 1 AND SCORE1 < SCORE2 THEN SCORE1
						ELSE SCORE1
					END AS SCORE_01,
					0 AS SCORE_02,
					0 AS SCORE_03,
					0 AS SCORE_04,
					0 AS SCORE_05,
					0 AS SCORE_06
			FROM ms_regu_sum WITH(NOLOCK)
			WHERE CON_ENT_DGN_NO = ?v_ced_no
			
			UNION 
			
			SELECT 
				   CON_ENT_DGN_NO,
				   0 AS SCORE_01,
				   COUNT(1) AS SCORE_02,
				   0 AS SCORE_03,
				   0 AS SCORE_04,
				   0 AS SCORE_05,
				   0 AS SCORE_06
			FROM ms_search_sum WITH(NOLOCK)
			WHERE TYPE = '1'
			AND CON_ENT_DGN_NO = ?v_ced_no
			GROUP BY CON_ENT_DGN_NO
			
			UNION
			
			SELECT
					CON_ENT_DGN_NO,
					0 AS SCORE_01,
				    0 AS SCORE_02,
					A.BEF_SCORE AS SOCRE_03,
					0 AS SCORE_04,
					0 AS SCORE_05,
				    0 AS SCORE_06
			FROM MS_BEF_EST_SCORE A, (SELECT DISTINCT CON_ENT_DGN_NO, USER_ID, CON_ENT_DGN_DATE FROM MS_STT_META WITH(NOLOCK)) B
			WHERE A.USER_ID = B.USER_ID
			AND B.CON_ENT_DGN_NO = ?v_ced_no
			-- AND A.MONTH = format(GETDATE(),'yyyyMM')
			AND A.MONTH = SUBSTRING(B.CON_ENT_DGN_DATE, 0,7)

			UNION 
			
			SELECT CON_ENT_DGN_NO,
				   0 AS SCORE_01,
				   0 AS SCORE_02,
				   0 AS SCORE_03,
				   CONVERT(INT,ROUND(CONVERT(FLOAT,SUM(SECRET_CNT)) / COUNT(1) * 100,0)) AS SCORE_04,
				   0 AS SCORE_05,
				   0 AS SCORE_06
			FROM
			(SELECT  CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD, 
					CASE WHEN SUM((CASE WHEN SECRET_YN = 'N' THEN 1 ELSE 0 END)) > 0 THEN 0 ELSE 1 END AS SECRET_CNT
			FROM ms_regu_secret WITH(NOLOCK)
			WHERE CON_ENT_DGN_NO = ?v_ced_no
			GROUP BY CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD
			) RE
			GROUP BY CON_ENT_DGN_NO
			
			UNION
			
			SELECT CON_ENT_DGN_NO,
				   0 AS SCORE_01,
				   0 AS SCORE_02,
				   0 AS SCORE_03,
				   0 AS SCORE_04,
				   CONVERT(INT,ROUND(CONVERT(FLOAT,SUM(FOCUS_CNT)) / COUNT(1) * 100,0)) AS SCORE_05,
				   0 AS SCORE_06
			FROM
			(SELECT  CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD, CTRA_INSA_CLCD,
					CASE WHEN SUM((CASE WHEN FOCUS_YN = 'N' THEN 1 ELSE 0 END)) > 0 THEN 0 ELSE 1 END AS FOCUS_CNT
			FROM ms_regu_focus WITH(NOLOCK)
			WHERE CON_ENT_DGN_NO = ?v_ced_no
			GROUP BY CON_ENT_DGN_NO, SC_SNO, SC_LCLF_CD, SC_SCLF_CD, QST_CD, CNTR_CD, CTRA_INSA_CLCD
			) RE
			GROUP BY CON_ENT_DGN_NO
			
			UNION 
			
			SELECT 
				   CON_ENT_DGN_NO,
				   0 AS SCORE_01,
				   0 AS SCORE_02,
				   0 AS SCORE_03,
				   0 AS SCORE_04,
				   0 AS SCORE_05,
				   COUNT(1) AS SCORE_06
			FROM ms_search_sum WITH(NOLOCK)
			WHERE TYPE = '2'
			AND CON_ENT_DGN_NO = ?v_ced_no
			GROUP BY CON_ENT_DGN_NO
			
			)A
			GROUP BY A.CON_ENT_DGN_NO
			ORDER BY A.CON_ENT_DGN_NO
        ]]></query>
