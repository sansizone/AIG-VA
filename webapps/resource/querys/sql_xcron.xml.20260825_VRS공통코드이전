			AND B.USE_YN = 'Y' AND C.USE_YN = 'Y'
			-- AND M.DEL_YN = 'N' AND B.USE_YN = 'Y' AND C.USE_YN = 'Y'
			-- AND TO_CHAR(M.ALTR_DT, 'YYYYMMDDHH24MI') IN ('201804271119')
			GROUP BY SUBSTR(TO_CHAR(M.ALTR_DT, 'YYYYMMDDHH24MISS'), 0, 13)
			ORDER BY SUBSTR(TO_CHAR(M.ALTR_DT, 'YYYYMMDDHH24MISS'), 0, 13)

        ]]></query>
        <parameter name='sdate' value="AND TO_CHAR(M.ALTR_DT, 'YYYYMMDDHH24MI') BETWEEN ?SDATE AND ?EDATE" default="AND TO_CHAR(M.ALTR_DT, 'YYYYMMDD') = TO_CHAR(SYSDATE-1, 'YYYYMMDD')" />
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.getqstmngwebaction_2' datasource='aig_tm' type='prepared'>
		<description>시간대별 정보 조회</description>
		<result-name>msens.xcron.hansol.getqstmngwebaction_2</result-name>
		<query><![CDATA[
			
			SELECT RE.SC_SNO,
				   RE.SC_LCLF_CD,
				   RE.SC_SCLF_CD,
				   RE.QST_CD,
				   RE.CNTR_CD,
				   RE.QST_CDNM,
				   RE.QST_CNTS,
				   RE.QST_KIND_CD,
				   RE.SORTKEY,
				   RE.DEL_YN,
				   RE.RGTR_CRNO AS REG_ID,
				   TO_CHAR(RE.REGN_DT, 'YYYYMMDDHH24MISS') AS REG_DATE,
				   RE.UPDR_CRNO AS CHG_ID,
				   TO_CHAR(RE.ALTR_DT, 'YYYYMMDDHH24MISS') AS CHG_DATE
			FROM 
				(SELECT ROWNUM as RNUM,
				       M.SC_SNO,
				       M.SC_LCLF_CD,
				       M.SC_SCLF_CD,
				       M.QST_CD,
				       M.CNTR_CD,
				       M.QST_CDNM,
				       M.QST_CNTS,
				       M.QST_KIND_CD,
				       M.SORTKEY,
				       M.DEL_YN,
				       M.RGTR_CRNO,
				       M.REGN_DT,
				       M.UPDR_CRNO,
				       M.ALTR_DT
				FROM TSOWN.TB_SC_QST_MNG M, TSOWN.TB_SC_MNG B, TSOWN.TB_PROD_ATTR_MNG C
				WHERE M.SC_SNO = B.SC_SNO
				AND M.SC_LCLF_CD = B.SC_LCLF_CD
				AND B.PROD_CD = C.PROD_CD
				AND B.USE_YN = 'Y' AND C.USE_YN = 'Y'
				-- AND M.DEL_YN = 'N' AND B.USE_YN = 'Y' AND C.USE_YN = 'Y'
				AND SUBSTR(TO_CHAR(M.ALTR_DT, 'YYYYMMDDHH24MISS'), 0, 13) = ?ALTR_DT
				) RE
			WHERE RNUM BETWEEN ?FROM_RNUM AND ?TO_RNUM

        ]]></query>
	</sql-service>
	
