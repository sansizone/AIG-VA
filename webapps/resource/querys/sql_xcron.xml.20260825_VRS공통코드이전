	<sql-service name='msens.xcron.hansol.setscriptresultwebaction_1' datasource='is_stat' type='prepared'>
		<description>스크립트 점수 배정하기</description>
		<result-name>msens.xcron.hansol.setscriptresultwebaction_1</result-name>
		<query><![CDATA[
			
			SELECT r.CON_ENT_DGN_NO,
				   r.UCID,
				   r.SC_SNO,
				   r.SC_LCLF_CD,
				   r.SC_SCLF_CD,
				   r.QST_CD,
				   r.CNTR_CD,
				   r.CTRA_INSA_CLCD,
				   r.SCRIPT_SENT_ID,
				   r.START_TIME,
				   ISNULL(r.TA_SCORE,'') AS TA_SCORE,
				   ISNULL(r.SCH_SCORE,'') AS SCH_SCORE,
				   ISNULL(s.QST_KEYWORD, '') AS QST_KEYWORD,
				   ISNULL(r.CHG_DATE, '') AS CHG_DATE,
				   s.QST_RATE
			FROM ms_regu_score r WITH(NOLOCK), ms_script_sent s WITH(NOLOCK)
			WHERE r.SC_SNO = s.SC_SNO
			AND r.SC_LCLF_CD = s.SC_LCLF_CD
			AND r.SC_SCLF_CD = s.SC_SCLF_CD
			AND r.QST_CD = s.QST_CD
			AND r.CNTR_CD =s.CNTR_CD
			AND r.SCRIPT_SENT_ID = s.SCRIPT_SENT_ID
			AND r.REG_DATE IS NOT NULL
			AND CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
			ORDER BY r.REG_DATE

        ]]></query>
	</sql-service>

