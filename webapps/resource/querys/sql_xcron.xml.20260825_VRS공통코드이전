	<sql-service name='msens.xcron.hansol.setautoassignwebaction_1' datasource='is_stat' type='prepared'>
		<description>자동배분 대상 조회해오기</description>
		<result-name>msens.xcron.hansol.setautoassignwebaction_1</result-name>
		<query><![CDATA[
			SELECT TOP(100) M.CON_ENT_DGN_NO
							,(SELECT CODE_NAME from ms_codebook WITH(NOLOCK) WHERE CODE_TYPE='VSS160' AND CODE_ID =ISNULL(MAX(CHG_GRADE),MAX(GRADE))) GRADE
							,(SELECT  CASE WHEN (DATEPART(WEEKDAY, H.SOLAR) IN (7,1) OR H.DETAIL IS NOT NULL) THEN 'N'
									  ELSE 'Y' END
							  FROM ms_holiday_info H WITH(NOLOCK)
							  WHERE SOLAR = SUBSTRING(MAX(M.REG_DATE),0,9) ) AS AUTO_YN
			FROM ms_stt_meta M WITH(NOLOCK) LEFT OUTER JOIN MS_GRADE_SUM G WITH(NOLOCK) ON M.CON_ENT_DGN_NO = G.CON_ENT_DGN_NO
			WHERE 1=1
			AND M.STT_FLAG= 'Y' AND GRD_FLAG = 'Y' AND ASS_FLAG = 'N'
			-- AND M.CON_ENT_DGN_NO IN ('941906070169','941906069814','941906070176','941906069815','941906070368','941906070516') 
			GROUP BY M.CON_ENT_DGN_NO
			ORDER BY MAX(CON_ENT_DGN_DATE) ASC, MAX(M.REG_DATE) asc, MAX(ASS_R_TIME) ASC, M.CON_ENT_DGN_NO
			
        ]]></query>
