	<sql-service name='msens.xcron.hansol.getrealtimeinfo.encrypt_1_20100410' datasource='is_stat' type='prepared'>
		<description>UCID에 해당하는 암호화 대상 대화내용 조회</description>
		<result-name>msens.xcron.hansol.getrealtimeinfo.encrypt_1</result-name>
		<query><![CDATA[
			 SELECT CONTENT,
				   ISNULL(A.ENC_FLAG,'N') AS ENC_FLAG
			FROM MS_STT_RSLT_MERGE A WITH(NOLOCK) 
			LEFT OUTER JOIN 
				(SELECT A.UCID, CASE WHEN SUM(CASE WHEN A.GRD_FLAG ='Y' AND SRC_FLAG ='Y' THEN 1 ELSE 0 END) = COUNT(1) THEN 'Y' ELSE 'N' END GRD_FLAG,
						ISNULL((SELECT FILEID FROM ms_stt_bef_meta with(nolock) WHERE FILEID = ?UCID GROUP BY FILEID),'') AS FILEID
				 FROM ms_stt_meta A WITH(NOLOCK)
				 WHERE UCID = ?UCID
				 GROUP BY UCID)  B 
			ON A.UCID = B.UCID
			WHERE A.UCID = ?UCID
			AND STT_SP_FLAG = 'Y'
			AND ISNULL(B.GRD_FLAG, 'Y') = 'Y' AND ISNULL(B.FILEID,'') = ''
        ]]></query>
	 </sql-service>
	 
	 <sql-service name='msens.xcron.hansol.getrealtimeinfo.encrypt_1' datasource='is_stat' type='prepared'>
		<description>UCID에 해당하는 암호화 대상 대화내용 조회</description>
		<result-name>msens.xcron.hansol.getrealtimeinfo.encrypt_1</result-name>
		<query><![CDATA[
			 SELECT CONTENT,
				   ENC_FLAG
			FROM 
			(SELECT UCID,
			       CONTENT,
				   ISNULL(A.ENC_FLAG,'N') AS ENC_FLAG,
				   GRD_FLAG
			FROM MS_STT_RSLT_MERGE A WITH(NOLOCK) 
			LEFT OUTER JOIN
			(SELECT A.UCID, CASE WHEN SUM(CASE WHEN A.GRD_FLAG ='Y' AND SRC_FLAG ='Y' THEN 1 ELSE 0 END) = COUNT(1) THEN 'Y' ELSE 'N' END GRD_FLAG
			 FROM ms_stt_meta A WITH(NOLOCK)
			 WHERE UCID = ?UCID
			 GROUP BY UCID)  B 
			ON A.UCID = B.UCID
			WHERE A.UCID = ?UCID
			AND STT_SP_FLAG = 'Y') A
			LEFT OUTER JOIN
			(SELECT FILEID FROM ms_stt_bef_meta with(nolock) WHERE FILEID = ?UCID GROUP BY FILEID) B
			ON A.UCID = B.FILEID
			WHERE ISNULL(B.GRD_FLAG, 'Y') = 'Y' AND ISNULL(B.FILEID,'') = ''
        ]]></query>
	 </sql-service>
	 
	 
