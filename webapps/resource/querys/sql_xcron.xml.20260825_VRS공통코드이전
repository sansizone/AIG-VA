	<sql-service name='msens.xcron.hansol.getmrlscallwebaction_6' datasource='aig_tm' type='prepared'>
		<description>설계번호의 평가여부 가져오기</description>
		<result-name>DS_LIST</result-name>
		<query><![CDATA[
					SELECT COUNT(1) CNT 
					FROM (
						  SELECT
					            A.HTID
					            ,A.ESTTCATCD
					            ,A.ESTRESULTCD
					        FROM TSOWN.TB_PRE_EST_RESULT_HIST A,
		                        (
		                             SELECT MAX(HTID) KEEP(DENSE_RANK FIRST ORDER BY HTID DESC) as cur_htid,
		                                    max(SC_CD_ID) as SC_CD_ID,
		                                    max(EST_ITEM_VER) as EST_ITEM_VER
		                            FROM  TSOWN.TB_PRE_EST_HISTORY TEH
		                            WHERE TEH.CON_ENT_DGN_NO = ?CED_NO -- 가입설계번호
		                        ) B
		                    where A.HTID = cur_htid
		                    AND ESTTCATCD = 110101 -- 사전동의/MR/정액 사전 조회 답변 녹취 시간 코드 값
		                    AND ESTRESULTCD IS NOT NULL
   				         ) A   
        ]]></query>
	</sql-service>
	
