	<sql-service name='msens.xcron.hansol.getmrlscallwebaction_1' datasource='aig_tm' type='prepared'>
		<description>MR LS LIST TM으로부터 가져오기</description>
		<result-name>DS_LIST</result-name>
		<query><![CDATA[
			SELECT
				         CON_ENT_DGN_NO
				        ,MIN(REG_DT) REG_DT
				        ,REC_ID
				        ,CENTER_CD
				        ,CENTER_NM
				        ,AGENT_ID
				        ,AGENT_NM
				        ,CUST_ID
				        ,CON_IP_PSN_NAME
				        ,MIN(BIRTH_DT) BIRTH_DT 
				        ,regexp_replace(LISTAGG(LS_CODE,',') WITHIN GROUP (ORDER BY CON_ENT_DGN_NO), '([^,]+)(,\1)*(,|$)','\1\3') LS_CODE --중복제거 
				        ,regexp_replace(LISTAGG(MR_CODE,',') WITHIN GROUP (ORDER BY CON_ENT_DGN_NO), '([^,]+)(,\1)*(,|$)','\1\3') MR_CODE
				 FROM (       
						SELECT 
						        CON_ENT_DGN_NO
						        ,REG_DT
						        ,REC_ID
						        ,CENTER_CD
						        ,CENTER_NM
						        ,AGENT_ID
						        ,AGENT_NM
						        ,CUST_ID
						        ,CON_IP_PSN_NAME
						        ,CASE WHEN BIRTH_DT IS NOT NULL
						                 		THEN (CASE WHEN (SUBSTR(BIRTH_DT,7,1) = 1 OR SUBSTR(BIRTH_DT,7,1) = 2 OR SUBSTR(BIRTH_DT,7,1) = 5 OR SUBSTR(BIRTH_DT,7,1) = 6) THEN  '19'||SUBSTR(BIRTH_DT,0,6) 
						                 			 	   WHEN (SUBSTR(BIRTH_DT,7,1) = 3 OR SUBSTR(BIRTH_DT,7,1) = 4 OR SUBSTR(BIRTH_DT,7,1) = 7 OR SUBSTR(BIRTH_DT,7,1) = 8) THEN  '20'||SUBSTR(BIRTH_DT,0,6) 
						                 			 	   ELSE '18'||SUBSTR(BIRTH_DT,0,6) END)
						         	  ELSE '' END AS BIRTH_DT
						        ,APP_ACT LS_CODE
						        ,'' MR_CODE
						FROM 
						(
						SELECT
								        A.CON_ENT_DGN_NO AS CON_ENT_DGN_NO --설계번호
								        , A.REG_DT || A.REG_TM AS REG_DT -- 협회조회일시
								        , A.CENTER_CD AS CENTER_CD 
								        , (SELECT GROUP_NAME FROM TSOWN.TB_GROUP_INFO WHERE GROUP_CD = A.CENTER_CD) AS CENTER_NM --센터명
								        , A.AGENT_ID AS AGENT_ID --상담원아이디
								        , A.AGENT_NM AS AGENT_NM --상담원명
						                , CASE WHEN B.CON_IP_INS_CUST_NO IS NULL THEN A.CUST_NO
								               ELSE B.CON_IP_INS_CUST_NO
								          END AS CUST_ID --고객ID
								       , CASE WHEN B.CON_IP_ISD_NAME IS NULL THEN A.CON_IP_PSN_NAME
								               ELSE B.CON_IP_ISD_NAME
								          END AS CON_IP_PSN_NAME     --피보험자고객명
                                        , NVL(CON_IP_ISD_CD,E.IP_PSN_NO) AS BIRTH_DT
								        , C.REC_ST AS REC_ST
						                , A.ACT_HIST AS APP_ACT -- MR/LS 코드
						                , A.REC_ID
									FROM TSOWN.TB_APP_ACT_HIST A
									   , (SELECT T1.TM_PROCESSING_GB
                                                   ,T1.CON_ENT_DGN_NO
                                                   ,T2.CON_IP_ISD_NAME
                                                   ,T2.CON_IP_INS_CUST_NO
                                                   ,T1.CON_RCPT_DTM
                                                   ,T1.CON_APP_DATE
                                                   ,T1.CON_APP_TIME
                                                   ,REPLACE(PLS_DECRYPT_B64(T2.CON_IP_ISD_CD),'-','') AS CON_IP_ISD_CD 
                                            FROM TSOWN.TB_INSU_PLAN_MAST T1, TSOWN.TB_INSU_PLAN_DETAIL T2 WHERE T1.TM_NO = T2.TM_NO) B
                                         , (SELECT ENT_DGN_NO,REPLACE(PLS_DECRYPT_B64(IP_PSN_NO),'-','') AS IP_PSN_NO FROM TSOWN.TB_THR_EXP_REJOIN) E 
									    , TSOWN.TB_DAPP_INQ_MNG C
									    , (SELECT CON_ENT_DGN_NO, MIN(REG_DT) AS REG_DT FROM TSOWN.TB_APP_ACT_HIST WHERE APP_ACT = '21' GROUP BY CON_ENT_DGN_NO) D
									WHERE A.APP_ACT IN ('50')
									AND A.REG_DT BETWEEN  ?SDATE AND ?EDATE
                                    AND A.CON_ENT_DGN_NO = E.ENT_DGN_NO(+)
									AND A.CON_ENT_DGN_NO = B.CON_ENT_DGN_NO(+)
								--	AND NVL(B.TM_PROCESSING_GB , '00') != '06'
									AND A.HIST_SEQ = C.HIST_SEQ(+)
									AND A.CON_ENT_DGN_NO = D.CON_ENT_DGN_NO(+)
									ORDER BY A.CON_ENT_DGN_NO DESC ,A.APP_ACT ASC
						 ) A  
                               
						 UNION
						 
						SELECT 
						        CON_ENT_DGN_NO
						        ,REG_DT
						        ,REC_ID
						        ,CENTER_CD
						        ,CENTER_NM
						        ,AGENT_ID
						        ,AGENT_NM
						        ,CUST_ID
						        ,CON_IP_PSN_NAME
						        ,CASE WHEN BIRTH_DT IS NOT NULL
						                 		THEN (CASE WHEN (SUBSTR(BIRTH_DT,7,1) = 1 OR SUBSTR(BIRTH_DT,7,1) = 2 OR SUBSTR(BIRTH_DT,7,1) = 5 OR SUBSTR(BIRTH_DT,7,1) = 6) THEN  '19'||SUBSTR(BIRTH_DT,0,6) 
						                 			 	   WHEN (SUBSTR(BIRTH_DT,7,1) = 3 OR SUBSTR(BIRTH_DT,7,1) = 4 OR SUBSTR(BIRTH_DT,7,1) = 7 OR SUBSTR(BIRTH_DT,7,1) = 8) THEN  '20'||SUBSTR(BIRTH_DT,0,6) 
						                 			 	   ELSE '18'||SUBSTR(BIRTH_DT,0,6) END)
						         	  ELSE '' END AS BIRTH_DT
						        ,'' LS_CODE 
						        ,APP_ACT MR_CODE
						FROM 
						(
						SELECT
								        A.CON_ENT_DGN_NO AS CON_ENT_DGN_NO --설계번호
								        , A.REG_DT || A.REG_TM AS REG_DT -- 협회조회일시
								        , A.CENTER_CD AS CENTER_CD 
								        , (SELECT GROUP_NAME FROM TSOWN.TB_GROUP_INFO WHERE GROUP_CD = A.CENTER_CD) AS CENTER_NM --센터명
								        , A.AGENT_ID AS AGENT_ID --상담원아이디
								        , A.AGENT_NM AS AGENT_NM --상담원명
						                , CASE WHEN B.CON_IP_INS_CUST_NO IS NULL THEN A.CUST_NO
								               ELSE B.CON_IP_INS_CUST_NO
								          END AS CUST_ID --고객ID
								       , CASE WHEN B.CON_IP_ISD_NAME IS NULL THEN A.CON_IP_PSN_NAME
								               ELSE B.CON_IP_ISD_NAME
								          END AS CON_IP_PSN_NAME     --피보험자고객명
                                       , NVL(CON_IP_ISD_CD,E.IP_PSN_NO) AS BIRTH_DT
								        , C.REC_ST AS REC_ST
						                , A.ACT_HIST AS APP_ACT -- MR/LS 코드
						                , A.REC_ID
									FROM TSOWN.TB_APP_ACT_HIST A
									     , (SELECT T1.TM_PROCESSING_GB
                                                   ,T1.CON_ENT_DGN_NO
                                                   ,T2.CON_IP_ISD_NAME
                                                   ,T2.CON_IP_INS_CUST_NO
                                                   ,T1.CON_RCPT_DTM
                                                   ,T1.CON_APP_DATE
                                                   ,T1.CON_APP_TIME
                                                   ,REPLACE(PLS_DECRYPT_B64(T2.CON_IP_ISD_CD),'-','') AS CON_IP_ISD_CD 
                                            FROM TSOWN.TB_INSU_PLAN_MAST T1, TSOWN.TB_INSU_PLAN_DETAIL T2 WHERE T1.TM_NO = T2.TM_NO) B
									    , TSOWN.TB_DAPP_INQ_MNG C
                                        , (SELECT ENT_DGN_NO,REPLACE(PLS_DECRYPT_B64(IP_PSN_NO),'-','') AS IP_PSN_NO FROM TSOWN.TB_THR_EXP_REJOIN) E 
									    , (SELECT CON_ENT_DGN_NO, MIN(REG_DT) AS REG_DT FROM TSOWN.TB_APP_ACT_HIST WHERE APP_ACT = '21' GROUP BY CON_ENT_DGN_NO) D
									WHERE A.APP_ACT IN ('40')
									AND A.REG_DT BETWEEN  ?SDATE AND ?EDATE
									AND A.CON_ENT_DGN_NO = B.CON_ENT_DGN_NO(+)
								--	AND NVL(B.TM_PROCESSING_GB , '00') != '06'
                                	AND A.CON_ENT_DGN_NO = E.ENT_DGN_NO(+)
									AND A.HIST_SEQ = C.HIST_SEQ(+)
									AND A.CON_ENT_DGN_NO = D.CON_ENT_DGN_NO(+)
									ORDER BY A.CON_ENT_DGN_NO DESC ,A.APP_ACT ASC
						 ) A
				 ) B
				 GROUP BY CON_ENT_DGN_NO,CENTER_CD,CENTER_NM,AGENT_ID,AGENT_NM,CUST_ID,CON_IP_PSN_NAME,REC_ID     
        ]]></query>
	</sql-service>
	
	<sql-service name='msens.xcron.hansol.getmrlscallwebaction_2' datasource='is_stat' type='prepared' batch='true'>
		<description>ms_bef_mrls 테이블에 저장</description>
		<batch-name>DS_LIST</batch-name>
		<query><![CDATA[
					MERGE ms_bef_mrls AS A
					USING (SELECT 'X' AS DUAL) AS B
					ON ( 	 CON_ENT_DGN_NO = ?CON_ENT_DGN_NO
							AND REG_DT = ?REG_DT
						)
					WHEN MATCHED THEN
						UPDATE SET 
						REC_ID = ?REC_ID,
						MR_CODE = ?MR_CODE,
						LS_CODE = ?LS_CODE,
						CENTER_CD = ?CENTER_CD,
						CENTER_NM = ?CENTER_NM,
						AGENT_ID = ?AGENT_ID,
						AGENT_NM = ?AGENT_NM,
						CUST_ID = ?CUST_ID,
						CON_IP_PSN_NAME =?CON_IP_PSN_NAME,
						BIRTH_DT = ?BIRTH_DT,
						VA_FLAG = 'N',
						CHG_ID = 'SYSTEM',
						CHG_DATE =  format(GETDATE(),'yyyyMMddHHmmss')
					WHEN NOT MATCHED THEN
						INSERT(
							   CON_ENT_DGN_NO,
							   REG_DT,
							   REC_ID,
							   MR_CODE,
							   LS_CODE,
							   CENTER_CD,
							   CENTER_NM,
							   AGENT_ID,
							   AGENT_NM,
							   CUST_ID,
							   CON_IP_PSN_NAME,
							   BIRTH_DT,
							   VA_FLAG,
							   REG_ID,
							   REG_DATE,
							   CHG_ID,
							   CHG_DATE
