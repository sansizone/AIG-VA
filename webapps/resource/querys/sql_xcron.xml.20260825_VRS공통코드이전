						   A.QST_CD, 
						   A.CNTR_CD, 
						   A.QST_CDNM, 
						   A.QST_CNTS, 
						   A.QST_KIND_CD, 
						   A.SORTKEY, 
						   A.DEL_YN,
						   A.DEL_DATE,
						   A.REG_ID,
						   A.REG_DATE,
						   A.CHG_ID,
