				<condition key="O" value="AND Y.ORG2_CD = '?ORG2_CD'"/>
				<condition key="A" value=""/>
			</parameter> 
			<parameter name='org3_cd' value="AND Y.ORG3_CD = '?ORG3_CD'" default="" />
			<parameter name='user_id' value="AND Z.USER_ID in (?USER_ID)" default="" />
			<parameter name='istp_cd' value="AND Z.ISTP_CD = '?ISTP_CD'" default="" />
			<parameter name='prod_cd' value="AND Z.PROD_CD = '?PROD_CD'" default="" />
			<parameter name='anl_stat' value="AND Z.GRD_FLAG = '?ANL_STAT'" default="AND Z.GRD_FLAG &lt;&gt; 'E'" />
			<parameter name='new_user_id' value="AND WORK_MONTH &lt;= (SELECT ETC1 FROM ms_codebook where code_type='SYS103' and code_id != 00)" default="" />
