	<sql-service name='oba.oba080.getMentDetail.cnt.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>담보별 필수멘트 하단 그리드 쿼리</description>
		<result-name>DS_CNT_LIST</result-name>
		<query><![CDATA[
				SELECT
					COUNT(A.MENT_CD) CNT
			FROM MS_MENT_MNG A 
			LEFT OUTER JOIN (
			SELECT 
					B.*
					,A.START_TIME
					,A.STT_SENT_ID
					,A.STT_SENT
					,A.PROD_CD
					,A.DMBO_CD
					,A.MENT_CD 
			FROM 
				(select A.UCID
						,CON_ENT_DGN_NO
						,A.START_TIME
						,A.STT_SENT_ID
						,STT_SENT
						,PROD_CD
						,DMBO_CD
						,MENT_CD
				from ms_ment_score A, ms_stt_rslt B
				where A.UCID=B.UCID
				and A.START_TIME=B.START_TIME
				AND A.PROD_CD=?PROD_CD
				AND A.DMBO_CD=?DMBO_CD
				) A, 
				(SELECT 
					  DISTINCT
					  UCID,
					  CON_ENT_DGN_NO,
					  CON_ENT_DGN_DATE
				--	  ORG1_CD,
				--	  ORG1_NAME ORG1_NM,
				--	  ORG2_CD,
				--	  ORG2_NAME ORG2_NM,
				--	  ORG3_CD,
				--	  ORG3_NAME ORG3_NM,
				--	  B.USER_ID,
				--	  USER_NAME USER_NM
					FROM ms_stt_meta A,  VW_USERMASTER B 
					WHERE A.USER_ID = B.USER_ID
					AND CON_ENT_DGN_NO=?CED_NO
					AND CON_ENT_DGN_DATE BETWEEN ?SDATE AND ?EDATE
					AND SRC_FLAG <> 'N' -- T OR Y
					AND A.ISTP_CD = ?ISTP_CD
					AND A.PROD_CD=?PROD_CD
					AND B.ORG1_CD = ?ORG1_CD
					AND B.ORG2_CD = ?ORG2_CD
					AND B.ORG3_CD = ?ORG3_CD
					AND B.USER_ID = ?USER_ID
				) B
			WHERE A.UCID= B.UCID
			AND A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO
			) B ON A.PROD_CD = B.PROD_CD AND A.DMBO_CD = B.DMBO_CD AND A.MENT_CD = B.MENT_CD
			WHERE 1=1
			AND A.PROD_CD=?PROD_CD
			AND A.DMBO_CD=?DMBO_CD
		]]></query>
	</sql-service>
	
	<sql-service name='oba.oba080.getMentDetail.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>담보별 필수멘트 하단 그리드 쿼리</description>
		<result-name>DS_LIST</result-name>
		<query><![CDATA[
				
			SELECT
					CON_ENT_DGN_NO CED_NO
					-- A.PROD_CD
					,A.DMBO_CD
					,ISNULL((SELECT ENC_FLAG FROM ms_stt_rslt_merge Z WHERE B.UCID=Z.UCID),'Z') AS ENC_FLAG --Z면 STT가 없는거
					,(SELECT DMBO_NM FROM ms_dmbo D WHERE A.PROD_CD = D.PROD_CD AND A.DMBO_CD=D.DMBO_CD) AS DMBO_NM
					,A.MENT_CD
					,CONCAT(A.MENT_SENT,' {',A.MENT_KEYWORD,'}') MNG_MENT
					,START_TIME
					,UCID_DATE
					,STT_SENT STT_MENT
					,CASE WHEN CON_ENT_DGN_NO IS NULL THEN 'N' ELSE 'Y' END MENT_YN
			FROM MS_MENT_MNG A 
			LEFT OUTER JOIN (
			SELECT 
					B.*
					,A.START_TIME
					,A.STT_SENT_ID
					,A.STT_SENT
					,A.PROD_CD
					,A.DMBO_CD
					,A.MENT_CD 
			FROM 
				(select A.UCID
						,CON_ENT_DGN_NO
						,A.START_TIME
						,A.STT_SENT_ID
						,STT_SENT
						,PROD_CD
						,DMBO_CD
						,MENT_CD
				from ms_ment_score A, ms_stt_rslt B
				where A.UCID=B.UCID
				and A.START_TIME=B.START_TIME
				AND A.PROD_CD=?PROD_CD
				AND A.DMBO_CD=?DMBO_CD
				) A, 
				(SELECT 
					  DISTINCT
					  UCID,
					  UCID_DATE,
					  CON_ENT_DGN_NO,
					  CON_ENT_DGN_DATE
				--	  ORG1_CD,
				--	  ORG1_NAME ORG1_NM,
				--	  ORG2_CD,
				--	  ORG2_NAME ORG2_NM,
				--	  ORG3_CD,
				--	  ORG3_NAME ORG3_NM,
				--	  B.USER_ID,
				--	  USER_NAME USER_NM
					FROM ms_stt_meta A,  VW_USERMASTER B 
					WHERE A.USER_ID = B.USER_ID
					AND CON_ENT_DGN_NO=?CED_NO
					AND CON_ENT_DGN_DATE BETWEEN ?SDATE AND ?EDATE
					AND SRC_FLAG <> 'N' -- T OR Y
					AND A.ISTP_CD = ?ISTP_CD
					AND A.PROD_CD=?PROD_CD
					AND B.ORG1_CD = ?ORG1_CD
					AND B.ORG2_CD = ?ORG2_CD
					AND B.ORG3_CD = ?ORG3_CD
					AND B.USER_ID = ?USER_ID
				) B
			WHERE A.UCID= B.UCID
			AND A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO
			) B ON A.PROD_CD = B.PROD_CD AND A.DMBO_CD = B.DMBO_CD AND A.MENT_CD = B.MENT_CD
			WHERE 1=1
			AND A.PROD_CD=?PROD_CD
			AND A.DMBO_CD=?DMBO_CD
			ORDER BY A.MENT_CD ASC,CON_ENT_DGN_DATE DESC, STT_SENT_ID ASC
			OFFSET  CONVERT(INT,?_START) ROWS
 			FETCH NEXT CONVERT(INT,?_PAGESIZE) ROWS ONLY
		]]></query>
	</sql-service>
	
