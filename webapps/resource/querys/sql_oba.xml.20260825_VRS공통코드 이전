<sql-service name='oba.oba010t1t1.getInsuPlan.sel'  datasource="aig_tm" paging="false" type="simple">
		<description>상세정보</description>
		<result-name>DS_LIST</result-name>
		<query><![CDATA[
		SELECT 	A.TM_NO                     -- TM 설계번호
                       ,A.CON_ENT_DGN_NO            --가입 설계번호
                       ,A.CON_P_CONT_NAME        	--계약자
			           ,PLS_DECRYPT_B64(A.CON_P_PSN_NO)  CON_P_PSN_NO  --계약자주민
                       , CASE WHEN A.CON_P_CALL_SITE_GB = '01' THEN A.CON_P_HOME_ADDR_1
			                  WHEN A.CON_P_CALL_SITE_GB = '02' THEN A.CON_P_OFF_ADDR_1
			                  ELSE ''
			             END                                            AS CON_P_ADDR_1              -- 계약자 주소1                
                     ,CASE WHEN A.CON_P_CALL_SITE_GB = '01' THEN PLS_DECRYPT_B64(A.CON_P_HOME_ADDR_2)
			                  WHEN A.CON_P_CALL_SITE_GB = '02' THEN PLS_DECRYPT_B64(A.CON_P_OFF_ADDR_2)
			                  ELSE ''
			             END AS CON_P_ADDR_2              -- 계약자 주소2
                       , A.CON_P_HOME_TEL_DDD || A.CON_P_HOME_TEL1 || PLS_DECRYPT_B64(A.CON_P_HOME_TEL2)  CON_P_HOME_TEL -- 계약자 자택 전화번호
                       , A.CON_P_HP_DDD || A.CON_P_HP1 || PLS_DECRYPT_B64(A.CON_P_HP2) CON_P_HP -- 계약자 휴대번호
    		           , A.CON_P_OFF_TEL_DDD || A.CON_P_OFF_TEL1 || PLS_DECRYPT_B64(A.CON_P_OFF_TEL2) CON_P_OFF_TEL -- 계약자 직장번호
			           , A.CON_P_ETC_TEL_DDD || A.CON_P_ETC_TEL1 || PLS_DECRYPT_B64(A.CON_P_ETC_TEL2) CON_P_ETC_TEL -- 계약자 기타번호
                     /**피보험자*/
                     ,B.CON_IP_ISD_NAME CON_IP_ISD_NAME --피보험자명
                     ,PLS_DECRYPT_B64(B.CON_IP_ISD_CD) CON_IP_PSN_NO -- 피보험자 주민번호
                     ,CASE WHEN B.CON_IP_CALL_SITE_GB = '01' THEN B.CON_IP_ADDR_1
		                WHEN B.CON_IP_CALL_SITE_GB = '02' THEN B.CON_IP_OFF_ADDR_1
		                ELSE ''
		            END                                     AS CON_IP_ADDR_1              -- 피보험자 주소1
		          ,CASE WHEN B.CON_IP_CALL_SITE_GB = '01' THEN PLS_DECRYPT_B64(CON_IP_ADDR_2)
		                WHEN B.CON_IP_CALL_SITE_GB = '02' THEN PLS_DECRYPT_B64(CON_IP_OFF_ADDR_2)
		                ELSE ''
		            END                                     AS CON_IP_ADDR_2              -- 피보험자 주소2
				  ,B.CON_IP_TEL_DDD || B.CON_IP_TEL_NO1 ||  PLS_DECRYPT_B64(B.CON_IP_TEL_NO2) CON_IP_TEL --피보험자 자택전화번호
                  ,B.CON_IP_HP_DDD || B.CON_IP_HP1 || PLS_DECRYPT_B64(B.CON_IP_HP2) CON_IP_HP --피보험자 휴대번호
				  ,B.CON_IP_OFF_TEL_DDD || B.CON_IP_OFF_TEL1 || PLS_DECRYPT_B64(B.CON_IP_OFF_TEL2) CON_IP_OFF_TEL --피보험자 직장전화번호
				  ,B.CON_IP_ETC_TEL_DDD || B.CON_IP_ETC_TEL1 || PLS_DECRYPT_B64(B.CON_IP_ETC_TEL2) CON_IP_ETC_TEL --피보험자 기타번호
                 
                  /**납입자*/
                  ,A.CON_CON_OLT_DEPOSIT_NM -- 납입자
                  ,A.CON_CON_OLT_JM_ID --납입자 생년월일
                  ,A.CON_CON_OLT_TRANS_APNT_DD --이체지정일
                  ,A.CON_FST_OLT_BANK_NM -- 초회 카드
                  ,PLS_DECRYPT_B64(A.CON_FST_OLT_B_ACNT_NO) CON_FST_OLT_B_ACNT_NO -- 초회 카드번호
                  ,A.CON_FST_OLT_BANK_BRH_CD --유효기간
                  ,A.CON_CON_OLT_BANK_NM --자동이체
                  ,PLS_DECRYPT_B64(A.CON_CON_OLT_B_ACNT_NO) CON_CON_OLT_B_ACNT_NO --자동이체 카드번호
                  ,A.CON_APP_DATE
                  ,DECODE(A.CON_FST_CASH_MTH,'02','카드','03','자동이체','') CON_FST_CASH_MTH --초회
                  ,DECODE(A.CON_CASH_MTH,'02','카드','03','자동이체','') CON_CASH_MTH  -- 계속
				  ,A.CON_CON_OLT_BANK_BRH_CD --자동이체 유효기간
				  ,PLS_DECRYPT_B64(CON_P_E_MAIL) CON_P_E_MAIL -- 계약자 이메일
				  ,PLS_DECRYPT_B64(CON_IP_EMAIL) CON_IP_EMAIL -- 피보험자 이메일
				  ,TSOWN.FN_CODEBOOK('CMP017', CON_CON_OLT_RELATION_CD) CON_OLT_REL -- 계약자관계
                FROM TSOWN.TB_INSU_PLAN_MAST A
                    ,TSOWN.TB_INSU_PLAN_DETAIL B
                WHERE A.TM_NO           = B.TM_NO
              --  AND   A.CON_ENT_DGN_NO  = '941807863720'
                ?ced_no
		]]></query>
		<parameter name='ced_no' value="AND A.CON_ENT_DGN_NO = '?CED_NO'" default="" />
	</sql-service>
		
		
