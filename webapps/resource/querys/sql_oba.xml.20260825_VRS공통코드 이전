	<sql-service name='oba.oba010t5.getDmboRes.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>해당 설계의 담보 가져옴 및 준수개수 가져옴</description>
		<result-name>DS_MENT_RES</result-name>
		<query><![CDATA[
			SELECT AA.*
						,CONCAT(SCORE_CNT,'/',MNG_CNT) MENT_CNT
						,CASE WHEN (SELECT  TOP(1) SRC_FLAG FROM MS_STT_META Z WITH(NOLOCK) WHERE CON_ENT_DGN_NO = CED_NO ORDER BY SRC_FLAG ) <> 'Y' THEN '분석진행중' ELSE '분석완료' END SRC_FLAG
			FROM (
					SELECT 
						 CON_ENT_DGN_NO CED_NO
						,A.PROD_CD
						,MAX(DMBO_NM) DMBO_NM
						 ,Items DMBO_CD
						 ,COUNT(1) MNG_CNT
						 ,(SELECT COUNT(DISTINCT MENT_CD) FROM ms_ment_score B WHERE A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO and A.PROD_CD=B.PROD_CD and A.Items=B.DMBO_CD) SCORE_CNT
						FROM
						(SELECT 
								DISTINCT
								A.CON_ENT_DGN_NO,
								A.PROD_CD,
								A.SRC_FLAG,
								(SELECT DMBO_NM FROM MS_DMBO D WHERE D.PROD_CD = A.PROD_CD AND D.DMBO_CD = Items) DMBO_NM ,
								Items 
						FROM vw_usermaster B,ms_stt_meta A  outer apply  dbo.fn_split_string(DMBO_CD, ',')
						WHERE A.USER_ID=B.USER_ID
								
							AND A.PROD_CD =?PROD_CD
							AND A.CON_ENT_DGN_NO=?CED_NO
								
						) A, ms_ment_mng B
						 WHERE A.PROD_CD = B.PROD_CD AND A.Items = B.DMBO_CD
						 GROUP BY CON_ENT_DGN_NO,A.PROD_CD,Items
						  ) AA
						  ORDER BY DMBO_CD

		]]></query>
	</sql-service>
	
	<sql-service name='oba.oba010t5.getMentDetailRes.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>담보의 필수멘트와 STT 문장 가져옴</description>
		<result-name>DS_RES</result-name>
		<query><![CDATA[
			SELECT
					CON_ENT_DGN_NO CED_NO
					,A.DMBO_CD
					,ISNULL((SELECT DISTINCT ENC_FLAG FROM ms_stt_rslt_merge Z WHERE B.UCID=Z.UCID),'Z') AS ENC_FLAG --Z면 STT가 없는거
					,(SELECT DISTINCT DMBO_NM FROM ms_dmbo D WHERE A.PROD_CD = D.PROD_CD AND A.DMBO_CD=D.DMBO_CD) AS DMBO_NM
					,A.MENT_CD
					,CONCAT(A.MENT_SENT,' {',A.MENT_KEYWORD,'}') MNG_MENT
					,START_TIME
					,B.UCID 
					,(SELECT DISTINCT FILE_FULL_PATH FROM MS_STT_META WITH(NOLOCK) WHERE UCID = B.UCID AND CON_ENT_DGN_NO=?CED_NO) FILE_FULL_PATH
					,STT_SENT
					,CASE WHEN CON_ENT_DGN_NO IS NULL THEN 'N' ELSE 'Y' END MENT_YN
			FROM MS_MENT_MNG A 
			LEFT OUTER JOIN
				(SELECT A.UCID
						,CON_ENT_DGN_NO
						,A.START_TIME
						,A.STT_SENT_ID
						,STT_SENT
						,(SELECT DISTINCT UCID_DATE FROM MS_STT_META A WHERE B.UCID=A.UCID) UCID_DATE
						,PROD_CD
						,DMBO_CD
						,MENT_CD
				FROM ms_ment_score A, ms_stt_rslt B
				WHERE A.UCID=B.UCID
				AND A.START_TIME=B.START_TIME
				AND A.PROD_CD=?PROD_CD
				AND A.DMBO_CD=?DMBO_CD
				AND CON_ENT_DGN_NO=?CED_NO
			) B ON A.PROD_CD = B.PROD_CD AND A.DMBO_CD = B.DMBO_CD AND A.MENT_CD = B.MENT_CD
			WHERE 1=1
			AND A.PROD_CD=?PROD_CD
			AND A.DMBO_CD=?DMBO_CD
			ORDER BY A.MENT_CD, UCID_DATE, STT_SENT_ID
		]]></query>
	</sql-service>
	
	
	<sql-service name='oba.oba050.getVrsRank.sclf.sel'  datasource="is_stat" paging="false" type="simple">
		<description>VRS랭킹</description>
		<result-name>DS_SCLF_RANK</result-name>
		<query><![CDATA[
			SELECT
				TOP(50)
					--SC_SNO
					LCLF_CD
					,LCLF_NM
					,SCLF_CD
					,SCLF_NM
					,SCORE
					,ROW_NUMBER() OVER(ORDER BY SCORE DESC) RANK
			FROM (
				SELECT
				--	MAX(SC_SNO)	SC_SNO
					SC_LCLF_CD LCLF_CD
					,(SELECT SC_CDNM FROM tb_sc_code_mng B WHERE A.SC_LCLF_CD = B.SC_CD and TYPE_CD='L') LCLF_NM
					,SC_SCLF_CD SCLF_CD
					,(SELECT SC_CDNM FROM tb_sc_code_mng B WHERE A.SC_SCLF_CD = B.SC_CD and TYPE_CD='S') SCLF_NM
					,ROUND(AVG(ISNULL(SENT_SCORE,0)),2) SCORE
				FROM ms_regu_score A ,
				(select 
						 	 con_ent_dgn_no, 
							 con_ent_dgn_date
				FROM ms_stt_meta Z,  (SELECT ORG1_CD, ORG1_NAME, ORG2_CD, ORG2_NAME,ORG3_CD, ORG3_NAME, USER_ID, USER_NAME FROM vw_usermaster WHERE 1=1  ?new_user_id) Y			 
				WHERE  Z.USER_ID=Y.USER_ID 
							  AND Z.CON_ENT_DGN_DATE between '?SDATE' and '?EDATE'
							 ?istp_cd
							 ?prod_cd
							 ?user_id
							 ?anl_stat
							 ?org1_cd
							 ?org2_flag
							 ?org3_cd
						GROUP BY CON_ENT_DGN_NO,CON_ENT_DGN_DATE
				) B
				WHERE A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO
				GROUP BY SC_LCLF_CD,SC_SCLF_CD
				) Z
				 WHERE 1=1
			ORDER BY SCORE DESC

		]]></query>
