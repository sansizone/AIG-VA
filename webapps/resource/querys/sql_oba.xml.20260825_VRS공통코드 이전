		         ,NVL(  (SELECT LISTAGG(DMBO_CD, '&') WITHIN GROUP (ORDER BY ROWNUM) FROM ( 
		                 SELECT   TB1.INSUR_AMT, -- ORDER BY 를 DMBO_GB로만 하기때문에 그다음 ORDER절이 SELECT절에서 결정됨. 부득이 TM과 SELECT절 동일히 맞춤
