	<sql-service name='oba.oba040p1.getBanKeywordDeptRank.sel'  datasource="is_stat" paging="false" type="simple">
		<description>금지어 조직별 건수 조회</description>
		<result-name>DS_BAN_CNT</result-name>
		<query><![CDATA[
			SELECT
				TOP(50)
				   RANK() OVER(ORDER BY SUM(CONVERT(INT,COUNT)) DESC) RANK,
				   SUM(CONVERT(INT, COUNT)) AS BAN_CNT,
				   TREATYHQCD AS ORG1_CD,
				   TREATYBRHCD AS ORG2_CD,
				   TREATYBRHNM AS ORG2_NM,
				   TREATYDEPTCD AS ORG3_CD,
				   TREATYDEPTNM AS ORG3_NM,
				   USER_ID,
				   (SELECT USER_NAME FROM ms_usermaster WHERE USER_ID = B.USER_ID)+'('+USER_ID+')' AS USER_NAME
			FROM ms_search_sum B INNER JOIN (
					SELECT CON_ENT_DGN_DATE, CON_ENT_DGN_NO FROM ms_stt_meta M WHERE CON_ENT_DGN_DATE BETWEEN '?SDATE' and '?EDATE' AND M.SRC_FLAG = 'Y' GROUP BY CON_ENT_DGN_NO,CON_ENT_DGN_DATE 
			)A ON A.CON_ENT_DGN_NO = B.CON_ENT_DGN_NO
			WHERE TYPE='1'
			AND BASE_DATE BETWEEN '?SDATE' and '?EDATE'
			AND MENT_CD = '?ban_cd'
			?org1_cd
			?org2_flag
			?org3_cd
			?user_id
			?istp_cd
			?prod_cd
			?new_user_id
			GROUP BY TREATYHQCD, TREATYBRHCD,TREATYBRHNM,TREATYDEPTCD,TREATYDEPTNM,USER_ID
			ORDER BY RANK() OVER(ORDER BY SUM(CONVERT(INT,COUNT)) DESC)
		]]></query>
		<parameter name='org1_cd' value="AND B.TREATYHQCD  = '?ORG1_CD'" default="" />
		<parameter name='org2_flag' value="" default="" >
			<condition key="M" value="AND B.TREATYBRHCD IN (SELECT CODE_ID FROM MS_CODEBOOK WHERE CODE_TYPE = 'SYS002' AND CODE_ID NOT IN  ('KB00','00') AND USE_YN = 'Y')"/>
			<condition key="O" value="AND B.TREATYBRHCD = '?ORG2_CD'"/>
			<condition key="A" value=""/>
		</parameter>
		<parameter name='org3_cd' value="AND B.TREATYDEPTCD = '?ORG3_CD'" default="" />
		<parameter name='user_id' value="AND B.USER_ID in (?USER_ID)" default="" />
		<parameter name='istp_cd' value="AND B.ISTP_CD = '?ISTP_CD'" default="" />
		<parameter name='prod_cd' value="AND B.PROD_CD = '?PROD_CD'" default="" ></parameter>
		<parameter name='new_user_id' value="AND B.USER_ID IN (SELECT USER_ID FROM ms_usermaster WHERE WORK_MONTH &lt;= (SELECT ETC1 FROM ms_codebook where code_type='SYS103' and code_id != 00))" default="" />
	</sql-service>

	<sql-service name='oba.oba010t2.getVrsRes.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>VRS문장 조회 - 팝업용</description>
		<result-name>DS_SCRIPT_RES</result-name>
		<query><![CDATA[
			SELECT LCLF_CD,
					  (SELECT SC_CDNM FROM tb_sc_code_mng t WHERE t.SC_CD = AA.LCLF_CD and TYPE_CD='L' and USE_YN ='Y') LCLF_NM
					  ,SCLF_CD
					  ,(SELECT SC_CDNM FROM tb_sc_code_mng t WHERE t.SC_CD = AA.SCLF_CD and TYPE_CD='S' and USE_YN ='Y') SCLF_NM
					  ,CTRA_INSA_CLCD
					  ,CONCAT(SUM(CASE WHEN SCORE > 0 THEN 1 ELSE 0 END), ' / ' , COUNT(1) ) AS REGU_Y_CNT
					  ,ISNULL(CONVERT(INT,ROUND(AVG(SCORE),0,0)),0) AVG_SCORE
				FROM (
									SELECT
										LCLF_CD, SCLF_CD, CTRA_INSA_CLCD, MAX(SCORE) AS SCORE
									FROM
										(SELECT
												SC_LCLF_CD LCLF_CD
												,SC_SCLF_CD SCLF_CD
												,QST_CD
												,SCRIPT_SENT_ID
												,CTRA_INSA_CLCD
												,SENT_SCORE SCORE
												FROM ms_regu_score r 		--문장 준수한 테이블
												WHERE CON_ENT_DGN_NO=?CED_NO
												AND (SELECT distinct GRD_FLAG FROM MS_STT_META A WHERE A.CON_ENT_DGN_NO=?CED_NO)  <> 'E'
										
								UNION
										SELECT
												SC_LCLF_CD LCLF_CD
												,SC_SCLF_CD SCLF_CD
												,QST_CD
												,SCRIPT_SENT_ID
												,CTRA_INSA_CLCD
												,SENT_SCORE SCORE
											FROM MS_REGU_OMIT R			   --누락한 문장들 테이블
											WHERE CON_ENT_DGN_NO=?CED_NO
											AND (SELECT distinct GRD_FLAG FROM MS_STT_META A WHERE A.CON_ENT_DGN_NO=?CED_NO)  <> 'E'
										) A
								GROUP BY LCLF_CD, SCLF_CD, QST_CD,CTRA_INSA_CLCD, SCRIPT_SENT_ID
					) AA
					GROUP BY LCLF_CD,SCLF_CD,CTRA_INSA_CLCD
		]]></query>
	</sql-service>

	<sql-service name='oba.oba010t2.getBanRes.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>금칙어요약 - 팝업용</description>
		<result-name>DS_BAN_RES</result-name>
		<query><![CDATA[
					SELECT	C.CODE_ID BAN_CD,
  							C.CODE_NAME AS BAN_KEYWORD,
							CASE WHEN B.BAN_CD IS NULL THEN 'N' ELSE 'Y' END AS BAN_YN,
							isnull(B.BAN_CNT,0) AS BAN_CNT
						FROM
							(SELECT
									MENT_CD BAN_CD
									,(select CODE_NAME from ms_codebook Z where CODE_TYPE='VSS150' and Z.CODE_ID = A.MENT_CD) BAN_NM
									,count(1) BAN_CNT
								FROM ms_search_score A, ms_stt_meta B
							 WHERE A.UCID=B.UCID
							 and  CON_ENT_DGN_NO=?CED_NO
							 and TYPE='1'
							 AND B.GRD_FLAG <> 'E'
							 group by MENT_CD) B
						RIGHT OUTER JOIN (SELECT CODE_ID, CODE_NAME FROM ms_codebook WHERE CODE_TYPE = 'VSS150' AND CODE_ID != 00 ?ban_cd) C
						ON B.BAN_CD = C.CODE_ID
						ORDER BY B.BAN_CNT DESC
		]]></query>
			<parameter name='ban_cd' value="AND CODE_ID = ?BAN_CD" default="" />
	</sql-service>

	<sql-service name='oba.oba010t2.getVrsRes.groupbyDate.sel'  datasource="is_stat" paging="false" type="prepared">
			<description>VRS문장 조회 - 팝업용 - 차트데이터</description>
			<result-name>DS_UD_VRS</result-name>
			<query><![CDATA[
				SELECT
					A.UCID
					,UCID_DATE DATE
					,B.SC_SCLF_CD SCLF_CD
					,(select SC_CDNM from tb_sc_code_mng t where t.SC_CD = B.SC_SCLF_CD and TYPE_CD='S' and USE_YN ='Y') SCLF_NM
					,1 COUNT
				FROM ms_stt_meta A, (SELECT UCID,CON_ENT_DGN_NO,SC_LCLF_CD,SC_SCLF_CD FROM ms_regu_score WHERE SENT_SCORE > 0 GROUP BY UCID,CON_ENT_DGN_NO,SC_LCLF_CD,SC_SCLF_CD) B
				WHERE A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO
				AND A.CON_ENT_DGN_NO=?CED_NO
				AND A.GRD_FLAG <> 'E'
				GROUP BY B.SC_SCLF_CD, A.UCID,UCID_DATE
				ORDER BY SCLF_CD, UCID_DATE ASC
			]]></query>
		</sql-service>

		<sql-service name='oba.oba010t2.getBanRes.groupbyDate.sel'  datasource="is_stat" paging="false" type="prepared">
				<description>VRS문장 조회 - 팝업용 - 차트데이터</description>
				<result-name>DS_UD_BAN</result-name>
				<query><![CDATA[
							SELECT
									B.UCID_DATE
									,MENT_CD BAN_CD
									,(select CODE_NAME from ms_codebook Z where CODE_TYPE='VSS150' and Z.CODE_ID = A.MENT_CD) BAN_NM
									,count(1) BAN_CNT
								FROM ms_stt_meta B , ms_search_score A
							 where A.UCID=B.UCID and TYPE='1'
							 and B.CON_ENT_DGN_NO=?CED_NO
							 AND B.GRD_FLAG <> 'E'
							 group by MENT_CD,UCID_DATE
							ORDER BY BAN_CD,UCID_DATE
				]]></query>
	</sql-service>

	<sql-service name='oba.oba010t3.getCtraRes.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>계피구분조회 - 팝업용</description>
		<result-name>DS_SCRIPT_RES_CTRA</result-name>
		<query><![CDATA[
			SELECT
				B.CODE_ID, B.CODE_NAME
			FROM
			(
				  SELECT distinct CS.Items AS CTRA_INSA_CLCD
					FROM ms_stt_meta X cross apply (SELECT Items FROM fn_split_string( X.CTRA_INSA_CLCD,',')) CS
					WHERE CON_ENT_DGN_NO = ?CED_NO
					AND X.GRD_FLAG <> 'E'
			) A, ms_codebook B
			WHERE B.CODE_TYPE = 'SYS105' 
			  AND A.CTRA_INSA_CLCD = B.CODE_ID
		]]></query>
	</sql-service>
	
	<sql-service name='oba.oba010t3.getSclfcd.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>소분류조회 - 팝업용</description>
		<result-name>DS_SCRIPT_RES_SCLF</result-name>
		<query><![CDATA[
			SELECT AA.*,
				SCLF_NM AS TEXT
				,REGU_N_CNT TEXT_CNT
		FROM (
			SELECT LCLF_CD,
					  (SELECT SC_CDNM FROM tb_sc_code_mng t WHERE t.SC_CD = AA.LCLF_CD and TYPE_CD='L' and USE_YN ='Y') LCLF_NM
					  ,SCLF_CD
					  ,(SELECT SC_CDNM FROM tb_sc_code_mng t WHERE t.SC_CD = AA.SCLF_CD and TYPE_CD='S' and USE_YN ='Y') SCLF_NM
					  ,CTRA_INSA_CLCD
					  ,CONCAT(SUM(CASE WHEN SCORE > 0 THEN 1 ELSE 0 END), '/' , COUNT(1) ) AS REGU_N_CNT
				FROM (
									SELECT
										LCLF_CD, SCLF_CD, CTRA_INSA_CLCD, MAX(SCORE) AS SCORE
									FROM
										(SELECT
												SC_LCLF_CD LCLF_CD
												,SC_SCLF_CD SCLF_CD
												,QST_CD
												,SCRIPT_SENT_ID
												,CTRA_INSA_CLCD
												,SENT_SCORE SCORE
												FROM ms_regu_score r 		--문장 준수한 테이블
												WHERE CON_ENT_DGN_NO=?CED_NO
												AND (SELECT distinct GRD_FLAG FROM MS_STT_META A WHERE A.CON_ENT_DGN_NO=?CED_NO)  <> 'E'
										
								UNION
										SELECT
												SC_LCLF_CD LCLF_CD
												,SC_SCLF_CD SCLF_CD
												,QST_CD
												,SCRIPT_SENT_ID
												,CTRA_INSA_CLCD
												,SENT_SCORE SCORE
											FROM MS_REGU_OMIT R			   --누락한 문장들 테이블
											WHERE CON_ENT_DGN_NO=?CED_NO
											AND (SELECT distinct GRD_FLAG FROM MS_STT_META A WHERE A.CON_ENT_DGN_NO=?CED_NO)  <> 'E'
										) A
								GROUP BY LCLF_CD, SCLF_CD, QST_CD,CTRA_INSA_CLCD, SCRIPT_SENT_ID
					) AA
					GROUP BY LCLF_CD,SCLF_CD,CTRA_INSA_CLCD
			) AA 
			
			ORDER BY LCLF_CD,SCLF_CD
		]]></query>
	</sql-service>
	
