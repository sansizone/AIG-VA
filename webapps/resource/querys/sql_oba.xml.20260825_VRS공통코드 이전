			UPDATE ms_ins_timestamp 
				SET 
					END_TIME = FORMAT(GETDATE(),'HHmmss')
					,WORK_TIME = DATEDIFF(ss,CONVERT(DATETIME,STUFF(STUFF(STUFF(WORK_DATE+START_TIME,9,0,' '),12,0,':'),15,0,':')), FORMAT(GETDATE(),'yyyy-MM-dd HH:mm:ss'))
