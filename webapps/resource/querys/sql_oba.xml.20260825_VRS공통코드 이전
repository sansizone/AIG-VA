		<sql-service name='oba.oba010p1.timestamp.upd'  datasource="is_stat" paging="false" type="prepared">
		<description>INSEPECT TIMESTAMP update</description>
		<query><![CDATA[
		--POP OPEN
		IF EXISTS (SELECT 1 FROM ms_ins_timestamp WHERE WORK_DATE = FORMAT(GETDATE(),'yyyyMMdd') AND USER_ID =?USER_ID AND CON_ENT_DGN_NO <> ?CED_NO and END_TIME IS NULL) 
					UPDATE ms_ins_timestamp  -- 비정상 종료 되어서 END_TIME 없는데 그 다음 설계가 30분 전에 들어오면 그 START_TIME으로 아니면 세션 타임아웃 시간으로(30분) 강제 업데이트
						SET 
							END_TIME = CASE WHEN(DATEDIFF(ss,CONVERT(DATETIME,STUFF(STUFF(STUFF(WORK_DATE+START_TIME,9,0,' '),12,0,':'),15,0,':')), FORMAT(GETDATE(),'yyyy-MM-dd HH:mm:ss'))) > 1800  THEN REPLACE(CONVERT(VARCHAR(8),DATEADD(MINUTE,30,CONVERT(DATETIME,STUFF(STUFF(STUFF(WORK_DATE+START_TIME,9,0,' '),12,0,':'),15,0,':'))),114),':','') ELSE FORMAT(GETDATE(),'HHmmss') END
							,WORK_TIME = CASE WHEN(DATEDIFF(ss,CONVERT(DATETIME,STUFF(STUFF(STUFF(WORK_DATE+START_TIME,9,0,' '),12,0,':'),15,0,':')), FORMAT(GETDATE(),'yyyy-MM-dd HH:mm:ss'))) > 1800  THEN '1800' ELSE DATEDIFF(ss,CONVERT(DATETIME,STUFF(STUFF(STUFF(WORK_DATE+START_TIME,9,0,' '),12,0,':'),15,0,':')), FORMAT(GETDATE(),'yyyy-MM-dd HH:mm:ss')) END
							,CHG_ID = 'SYSTEM'
							,CHG_DATE = FORMAT(GETDATE(),'yyyyMMddHHmmss')
						WHERE REG_DATE = (SELECT MAX(REG_DATE) FROM ms_ins_timestamp WHERE WORK_DATE = FORMAT(GETDATE(),'yyyyMMdd') AND USER_ID =?USER_ID AND CON_ENT_DGN_NO <> ?CED_NO and END_TIME IS NULL)
