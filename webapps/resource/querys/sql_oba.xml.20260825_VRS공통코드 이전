		        ,(SELECT ITEM_NAME FROM TSOWN.TBIA101 WHERE ITEM_CD = m.CON_I_KIND_CD) AS PROD_NM --상품명
		        ,(SELECT TREATYHQNM||'/'||TREATYBRHNM||'/'||TREATYDEPTNM FROM TSOWN.TB_USER U WHERE m.TM_TMR_ID =U.USERID)  AS DEPT_FULLNM -- 소속
			--  ,m.TM_PROCESSING_GB AS JUDGE_STAT_CD -- 심사상태코드
