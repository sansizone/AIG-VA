	<sql-service name='oba.oba010t1t6.getInsuPlanPaAuth.sel'  datasource="aig_tm" paging="false" type="simple">
		<description>친권자정보</description>
		<result-name>DS_LIST</result-name>
		<query><![CDATA[
				SELECT   TM_NO	--TM설계번호
						,CON_IP_INS_AIM_SEQ   --Q피보험목적순번
						,CON_IP_PSN_NO      --암호화피보험자주민등록번호
						,CON_FAMAILY_GB     --친권자대리인구분
					--	,TSOWN.FN_CODEBOOK('CMP017',CON_PA1_GB) CON_PA1_GB --친권자1 지정구분
						,CON_PA1_GB
						,PLS_DECRYPT_B64(CON_PA1_PSN_NO) CON_PA1_PSN_NO	    --암호화친권자1 주민번호
						,CON_PA1_NAME		    --친권자1 성명
						,CON_PA1_CUST_ID		--친권자1 고객ID
						,CON_PA1_HOME_TEL_DDD || CON_PA1_HOME_TEL1 || PLS_DECRYPT_B64(CON_PA1_HOME_TEL2)  CON_PA1_HOME_TEL--친권자1 자택전화지역번호
						,CON_PA1_OFF_TEL_DDD ||CON_PA1_OFF_TEL1|| PLS_DECRYPT_B64(CON_PA1_OFF_TEL2) CON_PA1_OFF_TEL --친권자1 직장전화지역번호
						,CON_PA1_ETC_TEL_DDD || CON_PA1_ETC_TEL1 || PLS_DECRYPT_B64(CON_PA1_ETC_TEL1) CON_PA1_ETC_TEL --친권자1 기타전화지역번호
						,CON_PA1_HP_DDD	|| CON_PA1_HP_NO1 || PLS_DECRYPT_B64(CON_PA1_HP_NO2) CON_PA1_HP_NO	--친권자1 핸드폰사업자번호
						,CON_PA1_FAX		--친권자1 팩스번호
						,CON_PA1_E_MAIL		--친권자1 이메일주소
						,CON_PA1_CALL_SITE_GB		--친권자1 주소구분
						,CON_PA1_ADDR_GB		--친권자1 신구주소구분코드
						,CON_PA1_ADDR_PTCD		--친권자1 주소유형코드
						,CON_PA1_ADDR_1		--친권자1 주소1
						,PLS_DECRYPT_B64(CON_PA1_ADDR_2) CON_PA1_ADDR_2		--친권자1 주소2
						--,TSOWN.FN_CODEBOOK('CMP017',CON_PA2_GB) CON_PA2_GB --친권자2 지정구분
						,CON_PA2_GB
						,PLS_DECRYPT_B64(CON_PA2_PSN_NO)	CON_PA2_PSN_NO	--암호화친권자2 주민번호
						,CON_PA2_NAME		--친권자2 성명
						,CON_PA2_CUST_ID		--친권자2 고객ID
						,CON_PA2_HOME_TEL_DDD || CON_PA2_HOME_TEL1 || PLS_DECRYPT_B64(CON_PA2_HOME_TEL2) CON_PA2_HOME_TEL	--친권자2 자택전화지역번호
						,CON_PA2_OFF_TEL_DDD || CON_PA2_OFF_TEL1 || PLS_DECRYPT_B64(CON_PA2_OFF_TEL2)	CON_PA2_OFF_TEL	--친권자2 직장전화지역번호
						,CON_PA2_ETC_TEL_DDD || CON_PA2_ETC_TEL1 || PLS_DECRYPT_B64(CON_PA2_ETC_TEL2) CON_PA2_ETC_TEL --친권자2 기타전화지역번호
						,CON_PA2_HP_DDD || CON_PA2_HP_NO1 || PLS_DECRYPT_B64(CON_PA2_HP_NO2)	CON_PA2_HP_NO	--친권자2 핸드폰사업자번호
						,CON_PA2_FAX		--친권자2 팩스번호
						,CON_PA2_E_MAIL		--친권자2 이메일주소
						,CON_PA2_CALL_SITE_GB		--친권자2 주소구분
						,CON_PA2_ADDR_GB		--친권자2 신구주소구분코드
						,CON_PA2_ADDR_PTCD		--친권자2 주소유형코드
						,CON_PA2_ZIP		--친권자2 우편번호
						,CON_PA2_ADDR_1		--친권자2 주소1
						,PLS_DECRYPT_B64(CON_PA2_ADDR_2)	CON_PA2_ADDR_2	--친권자2 주소2
						,CON_PA1_ZIP		--친권자1 우편번호
						,CON_PA1_FOREIGN_NAME		--친권자1 외국인명
						,CON_PA1_NATIONALITY		--친권자1 국적
						,CON_PA2_FOREIGN_NAME	--친권자2 외국인명
						,CON_PA2_NATIONALITY		--친권자2 국적
			  FROM TSOWN.TB_INSU_PLAN_PA_AUTH       
			 /* TM_NO를 모르고 가입설계번호를 알고 있을 경우*/
			 WHERE TM_NO IN (SELECT TM_NO FROM TSOWN.TB_INSU_PLAN_MAST WHERE CON_ENT_DGN_NO = '?CED_NO') --'941806041114' ) --'941705911893') 
			  /*AND CON_FAMAILY_GB = '1'*/  /* 1:대리인, 2:친권자 */
			   AND CON_FAMAILY_GB = '?CON_FAMAILY_GB'
		]]></query>
	</sql-service>
	
