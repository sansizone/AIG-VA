	<sql-service name='oba.oba010t2.getInsuPlanDtl.sel'  datasource="aig_tm" paging="false" type="simple">
		<description>고지사항</description>
		<result-name>DS_DETAIL</result-name>
		<query><![CDATA[
			SELECT   A.TM_NO 
					,B.CON_IP_INS_AIM_SEQ    --목적물순번
					,B.CON_IP_INS_CUST_NO --피보험자ID
					--,CON_IP_MAJ_REL_CD --주피관계명
					-- ,FN_CODEBOOK(A.CON_I_KIND_CD || 'REL',CON_IP_MAJ_REL_CD) CON_IP_MAJ_REL_CD
					,FN_CODEBOOK('CMP017' , B.CON_IP_CONT_RELATION_CD ) CON_IP_MAJ_REL_CD  -- 주피관계명
					,PLS_DECRYPT_B64(B.CON_IP_ISD_CD) CON_IP_ISD_CD --주민번호
					,B.CON_IP_ISD_NAME --성명
					,B.CON_IP_JOB_CD  --직업코드
					,B.CON_IP_JOB_NAME --직업명
					,B.CON_IP_VERSION --목적물버전
			FROM TSOWN.TB_INSU_PLAN_MAST A
			,TSOWN.TB_INSU_PLAN_DETAIL B
			WHERE A.TM_NO = B.TM_NO
			AND A.TM_NO IN (SELECT TM_NO 
			                FROM TSOWN.TB_INSU_PLAN_MAST 
			                WHERE 1=1 
			                --CON_ENT_DGN_NO  = '941807863720'
			                 ?ced_no
			                )
               
		]]></query>
		<parameter name='ced_no' value="AND CON_ENT_DGN_NO = '?CED_NO'" default="" />
	</sql-service>
	
	<sql-service name='oba.oba010t1t7.getUserInfo.sel'  datasource="aig_tm" paging="false" type="simple">
		<description>통합계약이력 - 사용자 정보</description>
