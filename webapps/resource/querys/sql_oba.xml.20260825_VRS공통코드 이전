					   SORTKEY,
				   (SELECT FILE_FULL_PATH FROM ms_stt_meta WHERE UCID = A.UCID AND CON_ENT_DGN_NO = ?CED_NO) AS FILE_FULL_PATH,
				   (SELECT ENC_FLAG FROM ms_stt_rslt_merge WHERE UCID = A.UCID) AS ENC_FLAG
				FROM ms_regu_score A, ms_stt_rslt B,ms_script_mng R
				WHERE A.UCID = B.UCID
				AND A.STT_SENT_ID = B.STT_SENT_ID
				AND A.SENT_SCORE >  0
				AND A.SC_SNO=R.SC_SNO
				AND A.SC_LCLF_CD=R.SC_LCLF_CD
				AND A.SC_SCLF_CD=R.SC_SCLF_CD
				AND A.QST_CD=R.QST_CD
				AND A.CNTR_CD=R.CNTR_CD
				?sclf_cd
				AND A.CON_ENT_DGN_NO =?CED_NO
				AND (SELECT distinct GRD_FLAG FROM MS_STT_META M WHERE M.CON_ENT_DGN_NO=?CED_NO)  <> 'E'
			) A
		GROUP BY SC_LCLF_CD,SC_SCLF_CD,QST_CD,CTRA_INSA_CLCD, UCID, SCRIPT_SENT_ID, FILE_FULL_PATH, ENC_FLAG,SORTKEY) AA, 
		(SELECT 
					A.SC_LCLF_CD,
					A.SC_SCLF_CD,
					A.QST_CD,
					A.CTRA_INSA_CLCD,
					   A.UCID,
					   A.SCRIPT_SENT_ID,
					   B.STT_SENT,
					   SENT_SCORE,
					   SORTKEY,
					   B.START_TIME
		FROM ms_regu_score A, ms_stt_rslt B,ms_script_mng R
			WHERE A.UCID = B.UCID
			AND A.STT_SENT_ID = B.STT_SENT_ID
			AND A.SENT_SCORE >  0
			AND A.SC_SNO=R.SC_SNO
			AND A.SC_LCLF_CD=R.SC_LCLF_CD
			AND A.SC_SCLF_CD=R.SC_SCLF_CD
			AND A.QST_CD=R.QST_CD
			AND A.CNTR_CD=R.CNTR_CD
			?sclf_cd
			AND A.CON_ENT_DGN_NO = ?CED_NO
			AND (SELECT distinct GRD_FLAG FROM MS_STT_META M WHERE M.CON_ENT_DGN_NO=?CED_NO)  <> 'E'
		) B
		WHERE AA.QST_CD = B.QST_CD
		AND AA.UCID=B.UCID
		AND AA.SENT_ID = B.SCRIPT_SENT_ID
		AND AA.SCORE=B.SENT_SCORE
		AND AA.CTRA_INSA_CLCD = B.CTRA_INSA_CLCD
		AND AA.CTRA_INSA_CLCD = ?CTRA_INSA_CLCD
		ORDER BY UCID, AA.SC_LCLF_CD,AA.SC_SCLF_CD,AA.SORTKEY,SCRIPT_SENT_ID
		]]></query>
		<parameter name='sclf_cd' value="AND A.SC_SCLF_CD= ?SCLF_CD" default="" />
	</sql-service>

