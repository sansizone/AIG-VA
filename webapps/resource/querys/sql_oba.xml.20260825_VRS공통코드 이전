<query-collection>

	<sql-service name="oba.oba020p1.getSent.sel" datasource="is_stat" paging="false" type="prepared">
		<description>스크립트결과가져오기</description>
		<result-name>DS_SCRIPT</result-name>
		<query><![CDATA[
			select SENTENCE
					,(SELECT STT_SENT FROM vs_regu_score WHERE SENT_ID = sc.SENT_ID AND SCORE = sc.SCORE ) STT_SENT
					,ROUND(CONVERT(float, sc.SCORE)*100,2) SCORE
			from (SELECT SENT_ID,MAX(SCORE) SCORE FROM vs_regu_score where rec_key = ?rec_key group by SENT_ID) sc
			left outer join vs_regu_sent st
			on sc.sent_id = st.sent_id
			where st.script_id = ?script_id
			order by SCORE DESC
		]]></query>
	</sql-service>

	 <sql-service name="oba.oba010.vrsScoreResult.cedno.cnt.sel" datasource="is_stat" paging="false" type="simple">
		<description>스크립트결과가져오기</description>
		<result-name>DS_CNT_LIST</result-name>
		<query><![CDATA[
			SELECT count(*) totalcount FROM(
			  SELECT MAX(B.CON_ENT_DGN_DATE) as CED_DATE
					  ,S.CON_ENT_DGN_NO CED_NO
					  ,MAX(S.USER_ID) USER_ID
					  ,CONCAT((SELECT USER_NAME FROM MS_USERMASTER WHERE USER_ID =  MAX(S.USER_ID)) , '(' ,  MAX(S.USER_ID), ')') AS USER_NAME
					  ,(SELECT COUNT(UCID) FROM ms_stt_meta M WHERE M.CON_ENT_DGN_NO=S.CON_ENT_DGN_NO AND CON_ENT_DGN_DATE between '?SDATE' and '?EDATE' ?anl_stat) CALL_CNT
					  ,(SELECT SUM(Y.DURATION) from (SELECT UCID FROM ms_stt_meta M WHERE M.CON_ENT_DGN_NO=S.CON_ENT_DGN_NO  AND CON_ENT_DGN_DATE between '?SDATE' and '?EDATE'  ?anl_stat) Z, ms_stt_rslt_merge Y WHERE Z.UCID=Y.UCID) AS RECODE_TIME
					  ,MAX(S.ISTP_NM) ISTP_NM
					  ,MAX(S.PROD_NM) PROD_NM
					  ,(SELECT STUFF((
									SELECT ',' + code_name
									FROM ms_codebook Z
								 where Z.CODE_ID in  (SELECT Items FROM dbo.fn_split_string(MAX(S.CTRA_INSA_CLCD), ','))
								  AND CODE_TYPE ='SYS105'  AND CODE_ID <> '00'
									FOR XML PATH('')
							   ),1,1,'')) AS CIC 
					  ,CONVERT(INT,MAX(S.SCORE1)) SCORE1
					  ,CONVERT(INT,ISNULL(MAX(S.SCORE2),0)) SCORE2
					  ,CASE WHEN LEN(MAX(S.CTRA_INSA_CLCD)) = 1 THEN CONVERT(INT,MAX(S.SCORE1))
					  ELSE CASE WHEN MAX(S.SCORE1) > MAX(S.SCORE2) THEN CONVERT(INT,MAX(S.SCORE2)) WHEN  MAX(S.SCORE1)<= MAX(S.SCORE2) THEN CONVERT(INT,MAX(S.SCORE1)) END END REG_SCORE
			 FROM ms_regu_sum S,  
			 		(SELECT 
							CON_ENT_DGN_NO,
							CON_ENT_DGN_DATE
						  FROM ms_stt_meta M
						  WHERE CON_ENT_DGN_DATE between '?SDATE' and '?EDATE'
						   ?anl_stat
						  GROUP BY CON_ENT_DGN_NO,CON_ENT_DGN_DATE
					  ) B
			 WHERE 1=1
			 and S.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO
			 ?org1_cd
			 ?org2_flag
			 ?org3_cd
			 ?user_id
			 ?istp_cd
			 ?prod_cd
			 ?ced_no
			 ?new_user_id
			 ?grade
			 GROUP BY S.CON_ENT_DGN_NO
			) aa
		]]></query>
		<parameter name='org1_cd' value="AND S.TREATYHQCD = '?ORG1_CD'" default="" />
		<parameter name='org2_flag' value="" default="" >
			<condition key="M" value="AND S.TREATYBRHCD IN (SELECT CODE_ID FROM MS_CODEBOOK WHERE CODE_TYPE = 'SYS002' AND CODE_ID NOT IN  ('KB00','00') AND USE_YN = 'Y')"/>
			<condition key="O" value="AND S.TREATYBRHCD = '?ORG2_CD'"/>
			<condition key="A" value=""/>
		</parameter> 
		<parameter name='org3_cd' value="AND S.TREATYDEPTCD = '?ORG3_CD'" default="" />
		<parameter name='user_id' value="AND S.USER_ID in (?USER_ID)" default="" />
		<parameter name='istp_cd' value="AND S.ISTP_CD = '?ISTP_CD'" default="" />
		<parameter name='prod_cd' value="AND S.PROD_CD = '?PROD_CD'" default="" ></parameter>
		<parameter name='ced_no' value="AND S.CON_ENT_DGN_NO like CONCAT(?CED_NO,'%')" default="" />
		<parameter name='grade' value="AND (select ISNULL(CHG_GRADE,GRADE) from ms_grade_sum Z where S.CON_ENT_DGN_NO=Z.CON_ENT_DGN_NO) = '?GRADE'" default="" />
		<parameter name='anl_stat' value="AND GRD_FLAG = '?ANL_STAT'" default="AND M.GRD_FLAG &lt;&gt; 'E'" />
		<parameter name='new_user_id' value="AND S.USER_ID IN (SELECT USER_ID FROM ms_usermaster WHERE WORK_MONTH &lt;= (SELECT ETC1 FROM ms_codebook where code_type='SYS103' and code_id != 00))" default="" />
		</sql-service> 

