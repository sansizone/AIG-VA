	<sql-service name="oba.oba010.vrsScoreResult.org.cnt.sel" datasource="is_stat" paging="false" type="simple">
		<description>스크립트결과가져오기</description>
		<result-name>DS_CNT_LIST</result-name>
		<query><![CDATA[
			SELECT count(*) totalcount FROM(
				SELECT
					   TREATYBRHCD ORG2_CD
					  ,TREATYDEPTCD ORG3_CD
					  ,S.USER_ID
					  ,MAX(TREATYHQNM) ORG1_NM
					  ,MAX(TREATYBRHNM) ORG2_NM
					  ,MAX(TREATYDEPTNM) ORG3_NM
					  ,CONCAT((SELECT USER_NAME FROM MS_USERMASTER WHERE USER_ID = S.USER_ID) , '(' , S.USER_ID, ')') AS USER_NAME
					  ,(SELECT COUNT(1) CED_CNT FROM (SELECT DISTINCT CON_ENT_DGN_NO FROM ms_stt_meta M WHERE M.USER_ID = S.USER_ID AND CON_ENT_DGN_DATE between '?SDATE' and '?EDATE' ?istp_cd ?prod_cd ?ced_no ?grade ?anl_stat) R ) AS CED_CNT
					  ,(SELECT COUNT(1) CALL_CNT FROM (SELECT UCID FROM ms_stt_meta M WHERE M.USER_ID = S.USER_ID AND CON_ENT_DGN_DATE between '?SDATE' and '?EDATE' ?istp_cd ?prod_cd ?ced_no ?grade ?anl_stat) R ) AS CALL_CNT
					  ,(SELECT SUM(Y.DURATION) from (SELECT UCID FROM ms_stt_meta M WHERE M.USER_ID = S.USER_ID  AND CON_ENT_DGN_DATE between '?SDATE' and '?EDATE' ?istp_cd ?prod_cd ?ced_no ?grade ?anl_stat) Z, ms_stt_rslt_merge Y WHERE Z.UCID=Y.UCID) AS RECODE_TIME
					  ,CONVERT(INT,ROUND(AVG(C.SUB_REG_SCORE),0,0)) REG_SCORE						  
			from  ms_regu_sum S,
			   (SELECT A.CON_ENT_DGN_NO, 
						CASE WHEN LEN(B.CTRA_INSA_CLCD) = 1 THEN B.SCORE1
							 ELSE CASE WHEN B.SCORE1 > B.SCORE2 THEN B.SCORE2 WHEN  B.SCORE1<= B.SCORE2 THEN B.SCORE1 END END SUB_REG_SCORE
				FROM (
					SELECT CON_ENT_DGN_NO, USER_ID FROM ms_stt_meta M WITH(NOLOCK)
					WHERE CON_ENT_DGN_DATE between '?SDATE' and '?EDATE'
					?anl_stat
			 		?istp_cd
			        ?prod_cd
			        ?user_id
			 		?ced_no
					GROUP BY CON_ENT_DGN_NO, USER_ID
				) A, ms_regu_sum B WITH(NOLOCK)
				WHERE A.CON_ENT_DGN_NO = B.CON_ENT_DGN_NO
				AND A.USER_ID = B.USER_ID 
			   ) C
				WHERE S.CON_ENT_DGN_NO = C.CON_ENT_DGN_NO
		 		?org1_cd
				?org2_flag
				?org3_cd
				?new_user_id
				?grade
			 GROUP BY TREATYHQCD,TREATYBRHCD,TREATYDEPTCD,S.USER_ID
			
			) aa
		]]></query>
		<parameter name='org1_cd' value="AND S.TREATYHQCD = '?ORG1_CD'" default="" />
