	<sql-service name='oba.oba070.getOmitMentRes.sel'  datasource="is_stat" paging="false" type="prepared">
		<description>필수멘트 누락항목 결과 조회</description>
		<result-name>oba.oba070.getOmitMentRes.sel</result-name>
		<query><![CDATA[
  			SELECT ?sql1
			FROM MS_DEPT D LEFT OUTER JOIN(
			SELECT
					?sql2
			FROM (
			SELECT S.MENT_CD, M.CON_ENT_DGN_NO, M.CON_ENT_DGN_DATE, M.USER_ID, M.TREATYHQCD, M.TREATYHQNM, M.TREATYBRHCD, M.TREATYBRHNM, M.TREATYDEPTCD, M.TREATYDEPTNM
			FROM (SELECT MENT_CD, CON_ENT_DGN_NO, COUNT, USER_ID, TREATYHQCD, TREATYHQNM, TREATYBRHCD, TREATYBRHNM, TREATYDEPTCD, TREATYDEPTNM
			       FROM ms_search_sum SS WHERE TYPE = 2 AND (SELECT distinct GRD_FLAG FROM MS_STT_META A WHERE A.CON_ENT_DGN_NO=SS.CON_ENT_DGN_NO)  <> 'E') S
			RIGHT OUTER JOIN
				  (SELECT DISTINCT M.CON_ENT_DGN_NO, M.CON_ENT_DGN_DATE,M.USER_ID, TREATYHQCD, TREATYHQNM, TREATYBRHCD, TREATYBRHNM, TREATYDEPTCD, TREATYDEPTNM
				   FROM ms_stt_meta M LEFT OUTER JOIN ms_grade_sum G ON M.CON_ENT_DGN_NO = G.CON_ENT_DGN_NO, ms_usermaster U 
				   WHERE M.USER_ID = U.USER_ID 
				   AND SRC_FLAG = 'Y'
				   AND M.CON_ENT_DGN_DATE BETWEEN ?SDATE AND ?EDATE
				   ?ced_no
				   ?user_id
				   ?anl_stat
				   ?grade
				   ?istp_cd
				   ?prod_cd
				   ?new_user_sql
				   ) M
			ON S.CON_ENT_DGN_NO = M.CON_ENT_DGN_NO
			) R
			GROUP BY ?groupby1) R
			ON ?join_sql
			AND D.USE_YN = 'Y'
			?org1_cd
			?org2_cd
			?org3_cd
			GROUP BY ?groupby2
		]]></query>
		<parameter name='org1_cd' value="AND D.ORG1_CD = ?ORG1_CD" default="" />
		<parameter name='org2_cd' value="AND D.ORG2_CD in (?ORG2_CD)" default="" />
		<parameter name='org3_cd' value="AND D.ORG3_CD = ?ORG3_CD" default="" />
		<parameter name='user_id' value="AND M.USER_ID in (?USER_ID)" default="" />
		<parameter name='ced_no' value="AND M.CON_ENT_DGN_NO LIKE '%?CED_NO%'" default="" />
		<parameter name='anl_stat' value="AND M.GRD_FLAG = '?ANL_YN'" default="AND M.GRD_FLAG &lt;&gt; 'E'" />
		<parameter name='grade' value="AND G.GRADE = ?GRADE" default="" />
		<parameter name='istp_cd' value="AND M.ISTP_CD = ?ISTP_CD" default="" />
		<parameter name='prod_cd' value="AND M.PROD_CD = ?PROD_CD" default="" />
	</sql-service>
	
