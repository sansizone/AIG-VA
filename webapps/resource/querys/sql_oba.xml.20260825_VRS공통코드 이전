		<parameter name='user_id' value="AND USER_ID in (?USER_ID)" default="" />
		<parameter name='istp_cd' value="AND M.ISTP_CD = '?ISTP_CD'" default="" />
		<parameter name='prod_cd' value="AND M.PROD_CD = '?PROD_CD'" default="" ></parameter>
		<parameter name='ced_no' value="AND M.CON_ENT_DGN_NO like CONCAT(?CED_NO,'%')" default="" />
		<parameter name='grade' value="AND (select ISNULL(CHG_GRADE,GRADE) from ms_grade_sum Z where Z.CON_ENT_DGN_NO=S.CON_ENT_DGN_NO) = '?GRADE'" default="" />
		<parameter name='anl_stat' value="AND M.GRD_FLAG = '?ANL_STAT'" default="AND M.GRD_FLAG &lt;&gt; 'E'" />
		<parameter name='new_user_id' value="AND S.USER_ID IN (SELECT USER_ID FROM ms_usermaster WHERE WORK_MONTH &lt;= (SELECT ETC1 FROM ms_codebook where code_type='SYS103' and code_id != 00))" default="" />
	</sql-service>
	
