		        ,CASE WHEN d.CON_IP_JOB_CLASS IS NOT NULL THEN d.CON_IP_JOB_CLASS||'급' ELSE '' END AS JOB_CLASS--직업급수
		        ,DECODE(M.MARKETING_AGREEMENT,'Y','예','아니오') AS PROD_DESC --상품소개
