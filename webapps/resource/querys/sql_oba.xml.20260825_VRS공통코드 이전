	<sql-service name='oba.oba010t1t1.getGradeInfo.sel'  datasource="is_stat" paging="false" type="simple">
		<description>분석정보</description>
		<result-name>DS_GRADE_INFO</result-name>
		<query><![CDATA[
				SELECT
				DURATION DURATION,
				CALL_CNT,
				A.CON_ENT_DGN_NO,
				ISNULL( (select CODE_NAME from ms_codebook where code_type='VSS160' and code_id =ISNULL(CHG_GRADE,GRADE)),'') +'('+RTRIM(ISNULL(CONVERT(varchar,ROUND(GRADE_SUM,0,0)),'0'))+')'   FIN_GRADE, --최종그레이드
				--(select CODE_NAME from ms_codebook where code_type='VSS160' and code_id =ISNULL(CHG_GRADE,GRADE)) +'('+ISNULL(CONVERT(INT,ROUND(GRADE_SUM,0,0)),0)+')'   FIN_GRADE, --최종그레이드
				VERSION GRADE_VERSION,
				ISNULL(CONVERT(INT,ROUND(GRADE_SUM,0,0)),0) GRADE_SCORE,-- 점수
				ISNULL(CONVERT(INT,ROUND(VRS_SCORE,0,0)),0) VRS_SCORE,
				ISNULL(CONVERT(INT,ROUND(BAN_SCORE,0,0)),0) BAN_SCORE,
				ISNULL(CONVERT(INT,ROUND(BEF_SCORE,0,0)),0) BEF_SCORE, --최종 grade
				ISNULL(CONVERT(INT,ROUND(SEC_SCORE,0,0)),0) SEC_SCORE,
				ISNULL(CONVERT(INT,ROUND(FOC_SCORE,0,0)),0) FOC_SCORE,
				ISNULL(CONVERT(INT,ROUND(MEN_SCORE,0,0)),0) MEN_SCORE,
				-- CASE WHEN CHG_GRADE IS NOT NULL THEN (select CODE_NAME from ms_codebook where code_type='VSS160' and code_id = GRADE) ELSE '' END BEF_GRADE,
				ISNULL(CHG_COMMENT,'') CHG_COMMENT,
				(select CODE_NAME from ms_codebook where code_type='VSS160' and code_id = GRADE) BEF_GRADE, --변경전그레이드
				GRD_FLAG,
				REASON
			FROM
				(
				 SELECT
						CON_ENT_DGN_NO,
						COUNT(Z.UCID) CALL_CNT,
						MAX(USER_ID) USER_ID,
						MAX(ISTP_CD) ISTP_CD,
						MAX(ISTP_NM) ISTP_NM,
						MAX(PROD_CD) PROD_CD,
						MAX(PROD_NM) PROD_NM,
						MAX(CON_P_CONT_NAME) CUST_NM,
						MAX(CON_ENT_DGN_DATE) CON_ENT_DGN_DATE,
						MAX(CON_CON_MONTH_PREM) MONTH_PREM,
						MAX(CON_CON_OLT_DEPOSIT_NM) NAB_NAME,
						MAX(CON_IP_ISD_NAME) P_NAME,
						MAX(DMBO_CD) DMBO_CD,
						MAX(INSUR_AMT) INSUR_AMT,
						MAX(BASIC_PREM) BASIC_PREM,
						SUM(Y.DURATION) DURATION,
						MAX(ASS_FLAG) ASS_FLAG,
						MAX(GRD_FLAG) GRD_FLAG,
						(CASE WHEN MIN(TA_FLAG) ='E' THEN '데이터가 없습니다.(TA)' WHEN MIN(SRC_FLAG)='E' THEN '오류가 발생했습니다.(검색)' WHEN MIN(TA_FLAG) <> 'E' AND MIN(SRC_FLAG) <> 'E' AND MAX(GRD_FLAG) ='E' THEN '오류가 발생했습니다. (등급부여)' END ) REASON
				 FROM ms_stt_meta Z , ms_stt_rslt_merge Y
				 WHERE Z.UCID=Y.UCID
				-- AND Z.GRD_FLAG <> 'E'
				 GROUP BY CON_ENT_DGN_NO) A LEFT OUTER JOIN ms_grade_sum B on A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO, ms_usermaster C 
				WHERE C.USER_ID=A.USER_ID
                ?ced_no
		]]></query>
		<parameter name='ced_no' value="AND A.CON_ENT_DGN_NO = '?CED_NO'" default="" />
	</sql-service>	
	
	
