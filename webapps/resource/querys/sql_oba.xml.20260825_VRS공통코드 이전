		<description>VRS랭킹</description>
		<result-name>DS_QST_RANK</result-name>
		<query><![CDATA[
			SELECT
				TOP(50)
					QST_CDNM
					,ROUND(AVG(ISNULL(SCORE,0)),2) SCORE
					,ROW_NUMBER() OVER(ORDER BY ROUND(AVG(ISNULL(SCORE,0)),2) DESC) RANK
			FROM (
					SELECT
					A.QST_CD
				, (SELECT QST_CDNM FROM ms_script_mng C WHERE  A.SC_SNO=C.SC_SNO and A.SC_LCLF_CD=C.SC_LCLF_CD and A.SC_SCLF_CD=C.SC_SCLF_CD and A.CNTR_CD=C.CNTR_CD and A.QST_CD=C.QST_CD) QST_CDNM
				,ISNULL(SENT_SCORE,0) SCORE
				FROM ms_regu_score A,
				(select 
						 	 con_ent_dgn_no, 
							 con_ent_dgn_date
				FROM ms_stt_meta Z,  (SELECT ORG1_CD, ORG1_NAME, ORG2_CD, ORG2_NAME,ORG3_CD, ORG3_NAME, USER_ID, USER_NAME FROM vw_usermaster WHERE 1=1 ?new_user_id) Y			 
				WHERE  Z.USER_ID=Y.USER_ID 
							  AND Z.CON_ENT_DGN_DATE between '?SDATE' and '?EDATE'
							 ?istp_cd
							 ?prod_cd
							 ?user_id
							 ?anl_stat
							 ?org1_cd
							 ?org2_flag
							 ?org3_cd
						GROUP BY CON_ENT_DGN_NO,CON_ENT_DGN_DATE
				) B
				WHERE A.CON_ENT_DGN_NO=B.CON_ENT_DGN_NO
				and A.SC_LCLF_CD = '?LCLF_CD'
				and A.SC_SCLF_CD = '?SCLF_CD'
				GROUP BY A.QST_CD,A.SC_SNO,A.SC_LCLF_CD,A.SC_SCLF_CD,A.CNTR_CD,A.QST_CD,SENT_SCORE
				) Z
				 WHERE 1=1
			GROUP BY QST_CDNM
			ORDER BY ROUND(AVG(ISNULL(SCORE,0)),2) DESC
		]]></query>
