		        ,DECODE(PROD_SMRY_SMS_SNDN_CSNT_YN,'Y','예',DECODE(PROD_SMRY_SMS_SNDN_CSNT_YN,'N','아니오',PROD_SMRY_SMS_SNDN_CSNT_YN)) AS SIXTYFIVE_YN --65세 안내장 발송 동의
